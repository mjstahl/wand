(library
 (name wand)
 (libraries unix re re.pcre yojson toml linenoise))

; The standard library, compiled into the binary as source text. The glob is
; what makes an edit to a `.wand` file rebuild the table -- get it wrong and
; a built binary carries yesterday's stdlib while every test still passes,
; which `test_stdlib_embed.ml` is there to catch.

; The version, from the one file that holds it. `make release` refuses to tag
; unless VERSION matches the tag, so a binary cannot claim a version that was
; never released.

(rule
 (targets version.ml)
 (deps %{workspace_root}/VERSION %{workspace_root}/tools/gen_version.exe)
 (action
  (with-stdout-to
   version.ml
   (run %{workspace_root}/tools/gen_version.exe %{workspace_root}/VERSION))))

(rule
 (targets stdlib_embed.ml)
 (deps
  (glob_files %{workspace_root}/stdlib/*.wand)
  %{workspace_root}/tools/gen_stdlib_embed.exe)
 (action
  (with-stdout-to
   stdlib_embed.ml
   (run %{workspace_root}/tools/gen_stdlib_embed.exe %{deps}))))
