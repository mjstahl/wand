import FS
import Path
import List

-- Copy every wand file into a backup directory. Nothing is annotated.

let backup_one! dest p = FS.copy! p (Path.of_string "${dest}/${Path.basename p}")

let backup_all! dest =
  let () = FS.mkdir! (Path.of_string dest) in
  List.each (fn (_, p) -> backup_one! dest p) (FS.glob *.wand)
