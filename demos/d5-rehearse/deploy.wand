uses {Env, FS.Write, Shell(echo, git)}

import FS
import Path
import Env

-- A deploy that builds, writes a config, syncs, and purges a cache.
-- The target is a directory under /tmp so the demo can run it for real.

let target = "/tmp/wand-demo-deploy"

let version! () = $(git describe --tags --always)

let deploy! () =
  let v = version! () in (
    FS.mkdir! (Path.of_string target);
    FS.write_file! (Path.of_string "%{target}/config.toml") "version = \"%{v}\"\n";
    Env.set "DEPLOYED_VERSION" v;
    $(echo rsync -a ./build/ web@host:/srv/app);
    FS.write_file! (Path.of_string "%{target}/cache.idx") "stale\n";
    FS.delete! (Path.of_string "%{target}/cache.idx");
    "deployed %{v}"
  )

deploy! ()
