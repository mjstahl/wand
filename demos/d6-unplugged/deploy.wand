uses {Shell(git), FS.Write}

import FS
import Path

-- The real thing: pushes to production and rewrites a system config.
-- Nothing in this file is written for testability.

let deploy! () =
  let version = $(git describe --tags) in (
    FS.write_file! (Path.of_string "/etc/app/config.toml") "version = \"%{version}\"\n";
    $(git push origin main);
    "deployed %{version}"
  )
