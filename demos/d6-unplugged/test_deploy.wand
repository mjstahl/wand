uses {Shell, FS.Read, FS.Write}

import Test
let [test] = import Test
import List
import String
import FS
import Path

let [deploy!] = import ./deploy

-- Each helper holds back one family of effects, and they compose.
let sealed thunk =
  Test.with_shell [("git describe", "v2.1.0")] (fn () -> Test.without_writes thunk)

test "it runs, on a plane" (fn t -> t.eq (sealed deploy!) "deployed v2.1.0")

test "it pushes exactly once" (fn t ->
  let cmds = Test.shell_calls (fn () -> Test.without_writes deploy!) in
  t.eq (List.length (List.filter (fn c -> String.contains? "push" c) cmds)) 1)

test "and nothing before the push touches prod" (fn t ->
  let cmds = Test.shell_calls (fn () -> Test.without_writes deploy!) in
  t.eq (List.head cmds) (Some "git describe --tags"))

test "it would write exactly one file" (fn t ->
  t.eq (Test.with_shell [] (fn () -> Test.writes deploy!)) ["/etc/app/config.toml"])

test "which was never written" (fn t ->
  let _ = sealed deploy! in t.eq (FS.exists? (Path.of_string "/etc/app/config.toml")) false)
