uses {Env, IO}

import Env
import FS
import IO
import Path

-- The None case has to go somewhere. Here it is refusing to do anything.
match Env.get "STAGING_DIR" with
| None -> IO.println "STAGING_DIR is not set; nothing to clean"
| Some "" -> IO.println "STAGING_DIR is empty; refusing to delete"
| Some path -> IO.println "would delete %{path}/"
