uses {IO}

import List
import String
import Map
import IO
import Stream

-- The hole said: Map 'a -> String -> Map 'a
-- so the reducer takes the tally so far and one line, and returns the tally.
let count tally line =
  let level = List.head (String.words line) in
  match level with
  | None -> tally
  | Some l -> (match Map.get l tally with
  | None -> Map.set l 1 tally
  | Some n -> Map.set l (n + 1) tally)

let levels = Stream.fold_left count Map.empty (IO.stdin_lines ())

levels
