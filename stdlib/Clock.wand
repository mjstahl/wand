uses {Clock}

-- Waiting.
--
-- Waiting, and reading the current instant.
--
-- `sleep` waits at least the duration it is given. A loaded machine, a
-- descheduled worker, or an interrupt window all make it longer. It is a
-- floor, not a promise.
--
-- A zero or a negative duration returns at once, and still performs the
-- effect: a trace sees it, and a handler that supplies a clock is not
-- stepped around by a value that happens to be zero.
--
-- Ctrl-C during a sleep takes effect at once. A sleep is the wrong thing
-- to make uninterruptible.

-- Wait for at least this long.
let sleep d = clock_sleep d

-- The current instant, in UTC. A local reading would make one script
-- answer differently on two machines, so there is no local form: use
-- `$(date)` where a human has to read a wall clock.
--
-- A `Duration` moves an instant, and two instants subtract to the length
-- between them:
--
-- Clock.now () - FS.mtime! log > 30d
-- Clock.now () + 1h
--
-- Reading it twice to measure how long work took is the one thing not to
-- do: a civil clock steps, so the second reading can be earlier than the
-- first. `Clock.timed` measures.
--
-- What it answers moves, so an example can only show its shape. Today at
-- midnight is a fixed hour whatever day it is read on:
--
-- >> Clock.now () |> DateTime.day_start |> DateTime.hour
-- 0 : Int
let now () = clock_now ()

-- Run `thunk` and answer with how long it took, beside what it returned:
--
-- let (took, report) = Clock.timed (fn () -> build ())
--
-- The length comes from a clock that no correction can move, so it is
-- right across an NTP step. It measures real elapsed time, and time while
-- the machine is suspended counts.
--
-- This is the only way wand measures a length of time. Two readings of
-- `Clock.now` would subtract to something a clock step can spoil.
--
-- The length comes first and what the thunk returned comes second, which
-- is the part a signature of `(Duration, 'a)` leaves to be guessed:
--
-- >> let (took, answer) = Clock.timed (fn () -> 1 + 1)
-- >> answer
-- 2 : Int
let timed thunk = (
  let before = clock_elapsed ();
  let answer = thunk ();
  (clock_elapsed () - before, answer)
)
