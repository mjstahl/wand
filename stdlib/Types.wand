(** Infer the type of a single expression, e.g. `Types.check "1 + 1"` -> `Ok "Int"`. *)
let check src = types_check_expr src

(** Infer the type of a full program (supports `type ...;` declarations, multiple
    bindings, and imports), e.g. `Types.check_program "type Color = Red | Green; Red"`. *)
let check_program src = types_check_program src

(** Return the inferred types of any holes (`?`) in a program, in source order. *)
let holes src = types_holes src

(** True if `src` typechecks to exactly `expected`. *)
let ok? src expected = check src == Ok expected

(** True if `src` fails to typecheck. *)
let fails? src =
  match check src with
  | Ok _ -> false
  | Error _ -> true
