(** Parse a TOML string.  Returns Ok TOML or Error message. *)
let parse src = toml_parse src

(** Parse a TOML string, raising on error. *)
let parse! src = toml_parse_exn src

(** Serialise a TOML table back to a TOML string. *)
let stringify t = toml_stringify t

(** Read and parse a TOML file.  Returns Ok TOML or Error message. *)
let read_file path = toml_read_file path

(** Read and parse a TOML file, raising on error. *)
let read_file! path = toml_read_file_exn path

(** True if the value is a TOML table. *)
let table? t = toml_is_table t

(** True if the value is a TOML array. *)
let array? t = toml_is_array t

(** Extract typed values.  Each returns Ok v or Error message. *)
let get_bool t = toml_get_bool t
let get_int t = toml_get_int t
let get_float t = toml_get_float t
let get_string t = toml_get_string t
let get_array t = toml_get_array t
let get_table t = toml_get_table t

(** Look up a key in a TOML table.  Returns Ok TOML or Error message. *)
let field key t = toml_field key t

(** Look up a key in a TOML table, raising if absent. *)
let field! key t = toml_field_exn key t

(** Read a typed value out of a TOML document. Failure names the field that
    failed and the path to it. See `Decode`. *)
let decode d t = toml_decode d t
