-- Reading through, without reading in.
--
-- A stream is a description of a source and its stages; nothing is read
-- until a terminal operation runs it -- open, each line through the
-- stages, close on the way out however the run ends. Like a Resource,
-- it describes; it is never the open thing, so it can be named, passed,
-- and folded twice.
-- Folding twice reads the source twice: traversal is not free and not
-- snapshotted.
--
--     FS.stream_lines /var/log/app.log
--     |> Stream.filter (fn l -> String.contains? "ERROR" l)
--     |> Stream.fold_left (fn n _ -> n + 1) 0
--
-- A source that can fail carries Raise in its row, and the failure
-- surfaces at the terminal operation, where the open happens; `try`
-- around the terminal call is the one capture.

-- A stream of a list's elements. The one source that performs nothing.
--
-- A stream on its own is a description and shows as one -- the work
-- happens when a terminal operation runs it:
--
-- >> Stream.of_list [1, 2, 3]
-- <stream> : Stream {..} Int
--
-- >> Stream.of_list [1, 2, 3] |> Stream.to_list
-- [1, 2, 3] : List Int
let of_list xs = stream_of_list xs

-- Transform each element as it flows.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.map (fn x -> x * 2) |> Stream.to_list
-- [2, 4, 6] : List Int
let map f s = stream_map f s

-- Keep the elements the predicate approves.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.filter (fn x -> x > 1) |> Stream.to_list
-- [2, 3] : List Int
let filter f s = stream_filter f s

-- At most n elements pass; the source stops being read once they have.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.take 2 |> Stream.to_list
-- [1, 2] : List Int
let take n s = stream_take n s

-- Read the source, folding every element into acc.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.fold_left (fn a x -> a + x) 0
-- 6 : Int
let fold_left f acc s = stream_fold f acc s

-- Read the source for f's effects, dropping what f returns.
--
-- >> Stream.of_list ["a", "b"] |> Stream.each (fn x -> IO.println x)
-- a
-- b
let each f s = stream_each f s

-- Read the source and keep everything -- the memory cost is the point of
-- saying it explicitly.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.to_list
-- [1, 2, 3] : List Int
let to_list s = stream_to_list s
