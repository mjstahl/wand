(** Run a shell command, returning its stdout as a string. Raises on non-zero exit. *)
let run       cmd = process_run cmd

(** Run a shell command, discarding output. Raises on non-zero exit. *)
let run_quiet cmd = process_run_quiet cmd

(** Run a shell command and return its exit code without raising. *)
let exit_code cmd = process_exit_code cmd

(** Return the process ID of the current process. *)
let pid       ()  = process_pid ()
