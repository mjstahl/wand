uses {IO}

-- Print a value without a trailing newline.
--
-- A string is written as its characters, with no quotes around it. That
-- is what makes it output rather than a value being shown.
--
-- >> IO.print "hi"
-- hi
let print v = io_print v

-- Print a value followed by a newline.
--
-- >> IO.println "hi"
-- hi
let println v = io_println v

-- Print a value to stderr without a trailing newline.
--
-- >> IO.print_err "careful"
-- careful
let print_err s = io_print_err s

-- Print a value to stderr followed by a newline.
--
-- >> IO.println_err "careful"
-- careful
let println_err s = io_println_err s

-- Read a line from stdin, returning the string without the newline.
-- Raises at end of input.
let read_line! () = io_read_line ()

-- Read a line from stdin, returning the string without the newline.
let read_line () = try read_line! ()

-- Read all remaining input from stdin as a single string. Raises on a
-- read error.
let read_all! () = io_read_all ()

-- Read all remaining input from stdin as a single string.
let read_all () = try read_all! ()

-- Flush stdout, ensuring all buffered output is written.
let flush () = io_flush ()

-- A stream of stdin's lines. The real stdin can be streamed once; a
-- second run raises. See Stream.
let stdin_lines () = io_stdin_lines ()
