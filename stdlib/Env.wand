uses {FS.Read, Env}

import Option

(** Return the value of an environment variable, or None if it is unset. *)
let get name =
  match try env_get_exn name with
  | Ok v -> Some v
  | Error _ -> None

(** Return the value of an environment variable. Raises if unset. *)
let get! name = env_get_exn name

(** Set an environment variable. *)
let set name value = env_set name value

(** Set an environment variable to the empty string. The name stays in the
    environment, so `get` returns `Some ""` rather than `None`. *)
let clear name = env_clear name

(** Return all environment variables as a list of (name, value) pairs. *)
let all () = env_all ()

(** Return the command-line arguments passed to the script. *)
let args () = env_args ()

(** Return the current user's home directory as a Path. *)
let home () = env_home ()

(** Return the current user's login name. *)
let user () = env_user ()

(** Parse a .env file and return its variables as a Map String.
    Raises if the file cannot be read. *)
let read! path =
  let src = read_file path in let pairs = env_read_dotenv src in map_from_list pairs

(** Parse a .env file and return its variables as a Map String. *)
let read path = try read! path

(** Parse a .env file and set all variables into the current environment.
    Raises if the file cannot be read. *)
let load! path = env_load_file path

(** Parse a .env file and set all variables into the current environment. *)
let load path = try load! path
