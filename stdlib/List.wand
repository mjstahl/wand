(** Apply a function to every element of a list, returning a new list. *)
let map _ []       = []
let map f [h : t] = f h : map f t

(** Keep only elements satisfying a predicate. *)
let filter _ []       = []
let filter p [h : t] =
  if p h then h : filter p t
  else filter p t

(** Reduce a list left to right with an accumulator. *)
let fold_left f acc []       = acc
let fold_left f acc [h : t] = fold_left f (f acc h) t

(** Reduce a list right to left with an accumulator. *)
let fold_right f []       acc = acc
let fold_right f [h : t] acc = f h (fold_right f t acc)

(** Return the number of elements in a list. *)
let length []       = 0
let length [_ : t] = 1 + length t

(** Concatenate two lists. *)
let append []       ys = ys
let append [h : t] ys = h : append t ys

(** Reverse a list. *)
let reverse xs = fold_left (fn acc x -> x : acc) [] xs

(** Return the first element of a list. Raises on empty list. *)
let head [h : _] = h

(** Return all elements after the first. Raises on empty list. *)
let tail [_ : t] = t

(** Return true if the list is empty. *)
let is_empty []  = true
let is_empty _   = false

(** Return true if any element satisfies the predicate. *)
let any _ []       = false
let any p [h : t] = if p h then true else any p t

(** Return true if all elements satisfy the predicate. *)
let all _ []       = true
let all p [h : t] = if p h then all p t else false

(** Return true if any element satisfies the predicate. Alias for any. *)
let find _ []       = false
let find p [h : t] = if p h then true else find p t

(** Pair up elements from two lists. Stops at the shorter list. *)
let zip []       _        = []
let zip _        []       = []
let zip [a : t] [b : u] = (a, b) : zip t u

(** Take the first n elements. *)
let take 0 _        = []
let take _ []       = []
let take n [h : t] = h : take (n - 1) t

(** Drop the first n elements. *)
let drop 0 xs       = xs
let drop _ []       = []
let drop n [_ : t] = drop (n - 1) t

(** Call f (index, element) for each element, for side effects. *)
let each f xs =
  let go _ []       = ()
      go i [h : t] = let () = f (i, h) in go (i + 1) t
  in go 0 xs

(** Sort a list using the default ordering. *)
let sort       xs   = list_sort xs

(** Sort a list by a key function. *)
let sort_by    f xs = list_sort_by f xs

(** Remove duplicate elements. *)
let unique     xs   = list_unique xs

(** Generate a list of integers from lo to hi (exclusive). *)
let range      lo hi = list_range lo hi

(** Flatten a list of lists into a single list. *)
let flatten    xs   = list_flatten xs

(** Concatenate two lists. Alias for append. *)
let concat     xs ys = list_concat xs ys
