import List

(** Return the number of characters in a string. *)
let length     s           = str_length s

(** Return true if the string is empty. *)
let is_empty?  s           = str_length s == 0

(** Convert a string to uppercase. *)
let upper      s           = str_upper s

(** Convert a string to lowercase. *)
let lower      s           = str_lower s

(** Strip leading and trailing whitespace. *)
let trim       s           = str_trim s

(** Strip leading whitespace. *)
let trim_left  s           = str_trim_left s

(** Strip trailing whitespace. *)
let trim_right s           = str_trim_right s

(** Return the substring from index from_ up to (not including) to_. *)
let slice      from_ to_ s = str_slice from_ to_ s

(** Split a string on a delimiter, returning a list of substrings. *)
let split      delim s     = str_split delim s

(** Return true if the string contains the given substring. *)
let contains?  needle s    = str_contains needle s

(** Return true if the string starts with the given prefix. *)
let starts_with? prefix s  = str_starts_with prefix s

(** Return true if the string ends with the given suffix. *)
let ends_with?   suffix s  = str_ends_with suffix s

(** Replace all occurrences of old_ with new_ in the string. *)
let replace    old_ new_ s = str_replace old_ new_ s

(** Repeat a string n times. *)
let repeat     n s         = str_repeat n s

(** Reverse a string. *)
let reverse    s           = str_reverse s

(** Return a list of single-character strings. *)
let chars      s           = str_chars s

(** Convert an integer to its string representation. *)
let of_int     n           = int_to_str n

(** Parse a string as an integer. Returns an error string on failure. *)
let to_int     s           = str_to_int s

(** Parse a string as a float. Returns an error string on failure. *)
let to_float   s           = str_to_float s

(** Join a list of strings with a separator. *)
let join sep xs =
  List.fold_left (fn acc x -> if acc == "" then x else acc ++ sep ++ x) "" xs

(** Split a string on newlines. *)
let lines s = str_split "\n" s

(** Split a string on spaces. *)
let words s = str_split " " s
