import String

-- A digest, and the algorithm that made it.
--
-- `Hash` computes; this module holds the answer and renders it. A digest
-- is a value with a shape and a meaning, so it is a type rather than a
-- hex String -- which buys two things a String would not.
--
-- It carries which algorithm made it, so comparing a sha256 against a
-- sha512 is a question the checker answers rather than a `false` that
-- reads like a failed verification.
--
-- And one value has two renderings. Checksum files are hex; S3 ETags and
-- subresource integrity are base64. Two accessors say that, where a
-- String would need two families of function.

-- Which digest.
--
-- `Sha256` and `Sha512` are for new work. `Sha1` and `Md5` are here for
-- interop and nothing else: git names objects with sha1 and S3 ETags are
-- md5, so a script matching one of those is not making a mistake. Leaving
-- them out would not stop anyone using them -- it would send them to
-- `Shell(md5sum)`, where the manifest names a binary again and the tool
-- differs between macOS and Linux.
type Algorithm = Sha256 | Sha512 | Sha1 | Md5

-- A digest: the algorithm, and its value written as lowercase hex.
type Digest(algorithm: Algorithm, hex: String)

-- The algorithm's name, as a checksum file writes it.
--
-- >> Digest.name Digest.Sha256
-- "sha256" : String
let name algorithm =
  match algorithm with
  | Sha256 -> "sha256"
  | Sha512 -> "sha512"
  | Sha1 -> "sha1"
  | Md5 -> "md5"

-- How many hex digits the algorithm's output takes.
let _hex_length algorithm =
  match algorithm with
  | Sha256 -> 64
  | Sha512 -> 128
  | Sha1 -> 40
  | Md5 -> 32

-- The digest as lowercase hex, which is what a checksum file holds.
--
-- The field is the same text; this is the spelling that pipes.
--
-- >> Hash.string Digest.Sha256 "abc" |> Digest.hex
-- "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" : String
let hex (digest: Digest) = digest.hex

-- The digest as base64, which is what an S3 ETag and a subresource
-- integrity attribute hold.
--
-- >> Hash.string Digest.Sha256 "abc" |> Digest.base64
-- "ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=" : String
let base64 (digest: Digest) =
  match hex_decode digest.hex with
  | Ok raw -> base64_encode raw
  | Error _ -> digest.hex

-- Which algorithm made this digest.
--
-- >> Hash.string Digest.Sha256 "abc" |> Digest.algorithm
-- Sha256 : Algorithm
let algorithm (digest: Digest) = digest.algorithm

-- Read a digest out of hex text, checking it against the algorithm.
--
-- The algorithm comes from the caller because the text cannot supply it:
-- 64 hex digits are a sha256 or half a sha512, and which one it is is
-- known by whoever read it out of a file.
--
-- >> Digest.of_hex Digest.Md5 "900150983cd24fb0d6963f7d28e17f72"
-- Ok(Digest(Md5, "900150983cd24fb0d6963f7d28e17f72")) : Result String Digest
--
-- >> Digest.of_hex Digest.Sha256 "abc"
-- Error("a Sha256 digest is 64 hex digits, and this is 3") : Result String Digest
let of_hex algorithm text =
  let want = _hex_length algorithm in
  let lower = String.lower text in
  if String.length lower != want then Error "a %{algorithm} digest is %{want} hex digits, and this is %{String.length lower}"
  else match hex_decode lower with
    | Error why -> Error why
    | Ok _ -> Ok Digest(algorithm = algorithm, hex = lower)

-- Read a digest out of hex text. Raises on text the algorithm rejects.
--
-- >> Digest.of_hex! Digest.Md5 "900150983cd24fb0d6963f7d28e17f72" |> Digest.algorithm
-- Md5 : Algorithm
let of_hex! algorithm text =
  match of_hex algorithm text with
  | Ok digest -> digest
  | Error why -> fail_exn why
