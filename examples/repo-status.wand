import String
import List

(* $() strips the trailing newline, so a non-empty capture has exactly one
   line per entry. Empty output is zero entries, not one empty line. *)
let count_lines out = if out == "" then 0 else List.length (String.lines out)

(* git rev-list --count prints a number; treat unparseable output as zero. *)
let to_count s = match String.to_int s with
  | Ok n    -> n
  | Error _ -> 0

let branch  = $(git branch --show-current)
let dirty   = count_lines $(git status --porcelain)
let ahead   = to_count $(git rev-list --count @{upstream}..HEAD 2>/dev/null || echo 0)
let behind  = to_count $(git rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)
let last    = $(git log -1 --format='%h %s')
let stashes = count_lines $(git stash list)

let status_msg =
  if dirty > 0 then "${dirty} file(s) changed" else "clean"

let sync_msg =
  if ahead > 0 || behind > 0
  then "^${ahead} ahead  v${behind} behind"
  else "up to date"

println "Branch:  ${branch}";
println "Status:  ${status_msg}";
println "Sync:    ${sync_msg}";
if stashes > 0 then println "Stashes: ${stashes} saved" else ();
println "Last:    ${last}"
