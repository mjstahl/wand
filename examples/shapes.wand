type Shape = Circle Int | Rect Int Int

let area s =
  match s with
  | Circle r -> r * r * 3
  | Rect w h -> w * h

let describe s =
  match s with
  | Circle r -> "circle(r=%{r})"
  | Rect w h -> "rect(%{w}x%{h})"

let c = Circle 5
let r = Rect 3 4

"%{describe c} area=%{area c}, %{describe r} area=%{area r}"
