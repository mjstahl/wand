uses {IO}

import IO
import List
import Map
import Stream
import String

-- Which clients made the most requests.
--
-- bash:  awk '{print $1}' access.log | sort | uniq -c | sort -rn | head -5
--
-- The pipeline re-reads the text four times and sorts the whole file to
-- count it. This counts as it goes, so the log never has to fit in memory,
-- and only the tally is sorted.

-- The first field of a common-log line is the client address. A line with
-- nothing on it contributes nothing.
let client line = String.word 0 line

let count_into counts line =
  match client line with
  | None -> counts
  | Some who -> Map.update who 0 (fn n -> n + 1) counts

-- Map.to_list gives pairs in the order the clients first appeared, which is
-- the order of the log. The sort decides the rest: by count, and by name
-- where two clients tie, so the answer does not depend on that order.
let busiest n counts =
  counts |> Map.to_list |> List.sort_by (fn (who, count) -> (0 - count, who)) |> List.take n

let report counts = (
  IO.println "Top talkers";
  IO.println "-----------";
  busiest 5 counts |> List.each (fn (who, count) -> IO.println "%{count}\t%{who}")
)

-- The stream is in `main` rather than in a binding: an import runs a
-- file's bindings, so a top-level `let counts = ...stdin...` would read
-- stdin the moment a test imported this.
let main! () = report (Stream.fold_left count_into Map.empty (IO.stdin_lines ()))

main! ()
