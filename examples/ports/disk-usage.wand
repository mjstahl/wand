uses {}

import List
import String

(* Reading `df -P` output. No command here and no printing: this is the part
   of the port that decides, and it is a module so that a test can import
   it. Importing a wand file runs it, so a script's own top level cannot be
   imported for its parts -- the deciding has to live in a file of its
   own. *)

(* A `df -P` row is: filesystem, blocks, used, available, capacity, mount.
   Capacity carries a `%`. A row without six fields is the header, or a
   filesystem whose name wrapped, and contributes nothing. *)
let usage row =
  match String.words row with
  | [_, _, _, _, capacity, mount] -> (
    match String.to_int (String.replace "%" "" capacity) with
    | Ok percent -> Some (mount, percent)
    | Error _ -> None
  )
  | _ -> None

(* The mounts over a percentage, in the order the rows came in. *)
let over limit rows =
  (List.fold_right
    (fn row acc -> match usage row with
      | Some (mount, percent) -> if percent > limit then (mount, percent) : acc else acc
      | None -> acc
    )
    rows
    [])
