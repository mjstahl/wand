uses {Env, IO, Proc}

import Args
import Decode
import Env
import IO
import List
import Option
import Port
import Proc

-- Read a command line, and refuse one that does not say what it means.
--
-- bash:  usage() { echo "usage: $0 [-p port] [-t timeout] [-v] host"; exit 1; }
--        port=8080; timeout=30; verbose=0
--        while getopts "p:t:v" opt; do
--          case $opt in
--            p) port=$OPTARG ;;
--            t) timeout=$OPTARG ;;
--            v) verbose=1 ;;
--            \?) usage ;;
--          esac
--        done
--        shift $((OPTIND - 1))
--        [ $# -eq 1 ] || usage
--        host=$1
--
-- Four places know the flags: the `getopts` string, the case arms, the
-- defaults above the loop, and the usage text. Adding one means editing
-- all four, and forgetting the fourth is the common way a usage message
-- goes stale. `getopts` also does short flags only -- `--port` needs a
-- hand-rolled loop -- and `$OPTARG` is a string, so `-p http` is taken
-- here and fails somewhere else, if anything checks it at all.
--
-- A type says the shape once. `--port http` is refused at the boundary,
-- naming the field, and `:8080` is a `Port` from there on.

type Opts(host: String, port: Port, timeout: Duration, verbose: Bool)

-- Exactly one positional argument. `Args` puts them under `_`, which no
-- flag can collide with.
let host_of =
  (Decode.and_then
    (fn hosts -> match hosts with
      | [h] -> Decode.succeed h
      | [] -> Decode.fail "expected a host"
      | _ -> Decode.fail "expected one host, got %{List.length hosts}"
    )
    (Decode.field "_" (Decode.list Decode.string)))

-- A flag that may be left out is `optional` and a default, which is the
-- same two facts the bash spreads over the getopts string and the
-- assignment above the loop.
let with_default d dec = Decode.map (fn v -> Option.default d v) dec

let opts =
  (Decode.map2
    (fn (h, p) (t, v) -> Opts(host = h, port = p, timeout = t, verbose = v))
    (Decode.map2
      (fn h p -> (h, p))
      host_of
      (with_default :8080 (Decode.optional "port" Decode.port))
    )
    (Decode.map2
      (fn t v -> (t, v))
      (with_default 30s (Decode.optional "timeout" Decode.duration))
      (with_default false (Decode.optional "verbose" Decode.bool))
    ))

-- Written by hand, because nothing derives it from the type. That is the
-- half of this row wand does not answer: the type and this string can
-- still drift, and only the type is checked.
let usage = "usage: probe-args [--port :8080] [--timeout 30s] [--verbose] host"

let render (o: Opts) =
  "%{o.host}%{o.port} timeout %{o.timeout}%{if o.verbose then " (verbose)" else ""}"

let main () =
  match Args.parse_with ["verbose"] opts (Env.args ()) with
  | Ok o -> IO.println (render o)
  | Error why -> (IO.println_err "%{why}"; IO.println_err usage; Proc.exit 1)

main ()
