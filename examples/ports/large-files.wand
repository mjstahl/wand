uses {FS.Read, IO}

import FS
import IO
import List
import Path
import Size

(* The biggest files in a tree.

   bash:  find . -type f -size +4k -exec ls -l {} \; | sort -k5 -rn

   `find`'s `-size +4k` counts blocks and rounds up, `ls -l` prints a number
   to sort on, and `sort -k5 -rn` reads it back out of the column it landed
   in. Three spellings of one number, and a filename with a space in it
   breaks the last two.

   The threshold is the literal `4KB`, because `FS.size` answers a `Size`
   and sizes compare. Sorting biggest-first is ascending and reversed: a
   size has no negation to sort by.

   One wall this port hit, recorded in docs/gaps.md: there is no
   `List.filter_map`, so keeping the files whose size could be read is the
   fold below rather than one stage of the pipeline. *)

let sized paths =
  let keep =
    fn p acc -> match FS.size p with
      | Ok size -> (p, size) : acc
      | Error _ -> acc
  in
  List.fold_right keep paths []

let over limit dir =
  FS.glob_in **.wand dir
    |> sized
    |> List.filter (fn (_, size) -> size > limit)
    |> List.sort_by (fn (_, size) -> size)
    |> List.reverse

let report limit dir = (
  println "Over %{Size.format limit} in %{Path.to_string dir}";
  over limit dir
    |> List.each (fn (p, size) -> println "%{Size.format size}\t%{Path.to_string p}")
)

let main () = report 4KB ./stdlib

main ()
