uses {Shell, FS.Read, FS.Write, Raise}

let [test] = import Test
import FS
import List
import Path
import String

(* What `${...}` inside `$()` does today, written down.

   This is a characterization test: it records behaviour rather than
   arguing for it. Interpolation is textual -- the command string is built
   and handed to `/bin/sh -c` -- so every shell metacharacter in an
   interpolated value is live. That is worth pinning down because it is
   easy to assume otherwise (this file exists because that assumption was
   made, stated twice, and was wrong), and because changing it to quote by
   default would be a change to the language rather than a fix.

   If `${...}` becomes "quote interpolate", most of these tests are
   supposed to fail. Each one says what it would then become, so the
   change can be made deliberately rather than discovered.

   `printf "[%s]"` prints one bracketed field per argument, which is how
   these tell "one argument" from "several". *)

let fields v = $(printf "[%s]" ${v})

(* ── One value, one argument ───────────────────────────────────────────── *)

test "a plain value is one argument" (fn t -> t.eq "[one]" (fields "one"))

(* ── Word splitting ────────────────────────────────────────────────────── *)

(* Under quote interpolate this becomes "[a b]", and a path with a space in
   it stops being a bug waiting to happen. *)
test "spaces split a value into several arguments" (fn t -> t.eq "[a][b]" (fields "a b"))

test "a tab splits too" (fn t -> t.eq "[a][b]" (fields "a\tb"))

(* Quoting characters are consumed by the shell rather than protecting
   anything: the value's own quotes are removed, and it still splits.
   Under quote interpolate: "[say \"hi\"]". *)
test "quotes in a value do not protect it" (fn t -> t.eq "[say][hi]" (fields "say \"hi\""))

(* Zero arguments, not one empty one. Under quote interpolate this stays
   "[]" but for the opposite reason -- one empty argument rather than
   none -- which `printf` cannot tell apart. *)
test "an empty value contributes no argument" (fn t -> t.eq "[]" (fields ""))

(* ── Expansion ─────────────────────────────────────────────────────────── *)

(* Under quote interpolate these all become the literal text. *)
test "a glob in a value is expanded by the shell" (fn t ->
  with FS.temp_dir "shell_glob_" as d ->
  let () = FS.write_file! (Path.join d (Path.of_string "a.txt")) "" in
  let () = FS.write_file! (Path.join d (Path.of_string "b.txt")) "" in
  let pattern = "${Path.to_string d}/*.txt" in
  t.eq 2 (List.length (String.lines $(ls ${pattern}))))

test "a tilde in a value is expanded" (fn t ->
  t.eq true (String.starts_with? "[/" (fields "~")))

(* ── Metacharacters run ────────────────────────────────────────────────── *)

(* These are the ones that matter. An interpolated value is shell source,
   so a value carrying `;`, `|`, `$(...)` or backticks runs commands. A
   script whose manifest says `uses {Shell}` can therefore run anything a
   value it was handed says to run.

   Under quote interpolate every one of these becomes inert text. *)
test "a semicolon in a value starts a second command" (fn t ->
  t.eq true (String.contains? "INJECTED" (fields "x; echo INJECTED")))

test "a pipe in a value builds a pipeline" (fn t ->
  t.eq true (String.contains? "PIPED" (fields "x | echo PIPED")))

test "command substitution in a value runs" (fn t ->
  t.eq true (String.contains? "SUB" (fields "$(echo SUB)")))

test "backticks in a value run" (fn t ->
  t.eq true (String.contains? "TICK" (fields "`echo TICK`")))

(* The sharpest form of the same fact: a value can be the entire command.
   This is the one call site in the corpus that quote interpolate would
   break outright, and the case a raw form exists to serve. *)
test "a value can be the whole command" (fn t ->
  let c = "echo whole" in t.eq "whole" $(${c}))

(* And it is not hypothetical: an interpolated value can write to disk. *)
test "an interpolated value can perform effects of its own" (fn t ->
  with FS.temp_dir "shell_inject_" as d ->
  let marker = "${Path.to_string d}/written-by-the-value" in
  let payload = "harmless; touch ${marker}" in
  let _ = $?(echo ${payload}) in t.eq true (FS.exists? (Path.of_string marker)))

(* ── $?() is the same mechanism ────────────────────────────────────────── *)

test "$?() interpolates the same way" (fn t ->
  let v = "a b" in let r = $?(printf "[%s]" ${v}) in t.eq "[a][b]" r.stdout)
