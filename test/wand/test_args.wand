let {test} = import Test
import Args
import Decode
import List
import String

-- Reading a command line with a decoder.
--
-- The point of this module is that it adds no combinators: argv becomes a
-- document, and `Decode` reads it exactly as it reads JSON or TOML. So
-- these tests are mostly about the one thing `Args` does -- turning a list
-- of strings into that document -- and about the errors naming the flag
-- they came from.

type Opts(port: Port, timeout: Duration, config: Path)

let opts args = Args.parse Opts.decoder args

-- ── Both spellings of a flag ────────────────────────────────────────────

test "--key=value" (fn t ->
  t.eq
    (Ok Opts(port = :8080, timeout = 30s, config = ./app.toml))
    (opts ["--port=8080", "--timeout=30s", "--config=./app.toml"]))

test "--key value" (fn t ->
  t.eq
    (Ok Opts(port = :8080, timeout = 30s, config = ./app.toml))
    (opts ["--port", "8080", "--timeout", "30s", "--config", "./app.toml"]))

test "the two can be mixed" (fn t ->
  t.eq
    (Ok Opts(port = :8080, timeout = 30s, config = ./app.toml))
    (opts ["--port=8080", "--timeout", "30s", "--config=./app.toml"]))

-- A value with an `=` in it survives, because only the first one splits.
test "a value may contain =" (fn t ->
  t.eq (Ok "a=b") (Args.parse (Decode.field "q" Decode.string) ["--q=a=b"]))

-- ── Domain types, which is the reason for doing it this way ─────────────

-- Reading a field off the decoded record, which is what a script does
-- next -- and the case `t.fail` exists for: an Error here is a broken
-- test, not a wrong value, and should say so rather than being compared
-- against something.
test "values arrive as the type the field asked for" (fn t ->
  match opts ["--port=8080", "--timeout=30s", "--config=./app.toml"] with
  | Ok o -> t.eq :8080 o.port
  | Error e -> t.fail e)

test "a bad value names the flag it came from" (fn t ->
  t.eq
    (Error `.port: expected Port, got "http"`)
    (opts ["--port=http", "--timeout=30s", "--config=./app.toml"]))

test "a missing flag names the field" (fn t ->
  t.eq (Error ".config: no such field") (opts ["--port=8080", "--timeout=30s"]))

-- ── Flags that take no value ────────────────────────────────────────────

let verbose args = Args.parse_with ["verbose"] (Decode.optional "verbose" Decode.bool) args

test "a named boolean flag is true when present" (fn t ->
  t.eq (Ok (Some true)) (verbose ["--verbose"]))

test "and absent otherwise" (fn t -> t.eq (Ok None) (verbose []))

-- Without the name, a flag takes whatever follows -- which is the whole
-- reason `parse_with` exists.
test "an undeclared flag consumes the next argument" (fn t ->
  t.eq
    (Ok (Some "deploy.wand"))
    (Args.parse (Decode.optional "verbose" Decode.string) ["--verbose", "deploy.wand"]))

test "a flag with nothing after it is an error" (fn t ->
  t.eq
    (Error "--config expects a value")
    (Args.parse (Decode.field "config" Decode.string) ["--config"]))

-- ── Positional arguments ────────────────────────────────────────────────

let files args = Args.parse (Decode.field "_" (Decode.list Decode.string)) args

test "positionals are reachable under _" (fn t ->
  t.eq (Ok ["a.txt", "b.txt"]) (files ["a.txt", "b.txt"]))

test "positionals survive being mixed with flags" (fn t ->
  t.eq (Ok ["a.txt", "b.txt"]) (files ["a.txt", "--port", "8080", "b.txt"]))

test "no arguments is an empty list, not an error" (fn t -> t.eq (Ok []) (files []))

-- Only `--name` is a flag. A single dash keeps `-5` an argument rather
-- than an option nobody declared.
test "a single dash is positional" (fn t -> t.eq (Ok ["-5"]) (files ["-5"]))

test "so are short flags, which this module does not have" (fn t ->
  t.eq (Ok ["-v"]) (files ["-v"]))

-- ── A flag that collects ────────────────────────────────────────────────

-- Whether a flag replaces or collects is the second fact argv cannot carry:
-- `--tag a` looks the same either way. `T.flags` says both, beside which
-- flags take no value.
type Collect(tag: List String, name: String = "x", verbose: Bool = false)

let read argv = Args.read Collect.spec Collect.decoder argv

test "a repeated flag collects" (fn t ->
  t.eq
    (Ok Collect(tag = ["a", "b"], name = "x", verbose = false))
    (read ["--tag", "a", "--tag", "b"]))

test "written once it is still a list" (fn t ->
  t.eq (Ok Collect(tag = ["a"], name = "x", verbose = false)) (read ["--tag", "a"]))

test "never written it is none of them" (fn t ->
  t.eq (Ok Collect(tag = [], name = "x", verbose = false)) (read []))

test "a flag that does not collect keeps the last value" (fn t ->
  t.eq
    (Ok Collect(tag = [], name = "b", verbose = false))
    (read ["--name", "a", "--name", "b"]))

test "the spec still says which flags take no value" (fn t ->
  t.eq (Ok Collect(tag = [], name = "x", verbose = true)) (read ["--verbose"]))

test "the inline form collects too" (fn t ->
  t.eq
    (Ok Collect(tag = ["a", "b"], name = "x", verbose = false))
    (read ["--tag=a", "--tag=b"]))

-- ── The end of the flags, and the question that is not one ──────────────

let _rest = Decode.field "_" (Decode.list Decode.string)

test "`--` ends the flags" (fn t ->
  t.eq (Ok ["-x", "--y", "z"]) (Args.parse _rest ["--", "-x", "--y", "z"]))

test "and what came before it is still positional" (fn t ->
  t.eq (Ok ["a", "--b"]) (Args.parse _rest ["a", "--", "--b"]))

test "a flag before it is still a flag" (fn t ->
  t.eq (Ok true) (Args.parse_with ["v"] (Decode.field "v" Decode.bool) ["--v", "--", "x"]))

test "`--` alone leaves nothing after it" (fn t -> t.eq (Ok []) (Args.parse _rest ["--"]))

test "help is asked for" (fn t -> t.eq true (Args.help? ["--verbose", "--help"]))

test "and not asked for" (fn t -> t.eq false (Args.help? ["--verbose"]))

test "after `--` it is an argument like any other" (fn t ->
  t.eq false (Args.help? ["--", "--help"]))

-- Reading a command line that asks for help says what to do about it.
test "reading one that asks for help names the answer" (fn t ->
  match Args.parse (Decode.field "v" Decode.bool) ["--help"] with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "Args.help?" why))
