uses {}

let {test, group} = import Test
let {usage, over} = import ../../examples/ports/disk-usage
import Option

(* The deciding half of a port, tested with no machine to read.

   The port is two files for exactly this reason: importing a wand file
   runs it, so the half that runs `df` and prints cannot be imported for
   its parts. *)

group "one row of df -P" (fn () -> [
  test "a mount and its percentage" (fn t ->
    t.eq (Some ("/", 91)) (usage "/dev/disk1s1 1000 910 90 91% /")),
  (* `Option.none?` rather than `t.eq None`: a bare `None` in an argument
     list takes the next argument, so `t.eq None (usage row)` reads as
     `t.eq (None (usage row))`. Recorded in docs/gaps.md. *)
  test "the header is not a row" (fn t ->
    t.ok (Option.none? (usage "Filesystem 1024-blocks Used Available Capacity Mounted on"))),
  test "a short row is not a row" (fn t ->
    t.ok (Option.none? (usage "/dev/disk1s1 1000"))),
  test "a capacity that is not a number" (fn t ->
    t.ok (Option.none? (usage "/dev/a 1 1 1 n/a /mnt")))
])

group "the mounts over a limit" (fn () -> [
  test "only what is over" (fn t ->
    t.eq [("/", 91)] (over 90 ["/dev/a 1 1 1 91% /", "/dev/b 1 1 1 12% /home"])),
  test "the limit itself is not over it" (fn t -> t.eq [] (over 90 ["/dev/a 1 1 1 90% /"])),
  test "in the order the rows came in" (fn t ->
    t.eq
      [("/", 99), ("/home", 95)]
      (over 90 ["/dev/a 1 1 1 99% /", "/dev/b 1 1 1 95% /home"]))
])
