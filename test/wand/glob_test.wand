import Test
import FS
import Path
import List
import Types

(* Glob literal syntax (`*.wand`, `**`, `./**/*.ml`, ...) is a distinct
   token/type from Path -- raw lexer-level assertions for that stay in
   test_glob.ml (no wand-source equivalent). This file covers the type
   and the real FS.glob/FS.glob! behavior. *)

test "glob literal type" (fn t ->
  let g = *.wand
  in t.ok true)

test "passing a Path where Glob expected is a type error" (fn t ->
  t.ok (Types.fails? "import FS\nFS.glob /etc ."))

test "passing a bare string where Glob expected is a type error" (fn t ->
  t.ok (Types.fails? "import FS\nFS.glob \"*.wand\" ."))

(* ── FS.glob ──────────────────────────────────────────────────────────── *)

let scratch_marker = FS.temp_file "wand_glob_test_" ""
let scratch = Path.to_string scratch_marker
let () = FS.delete scratch_marker
let () = FS.mkdir (Path.of_string scratch)

test "*.wand matches" (fn t ->
  let dir = Path.of_string scratch
  let () = FS.write_file "${scratch}/foo.wand" ""
  let () = FS.write_file "${scratch}/bar.wand" ""
  let () = FS.write_file "${scratch}/baz.ml" ""
  let names = FS.glob! *.wand dir |> List.map Path.basename |> List.sort
  let () = FS.delete (Path.of_string "${scratch}/foo.wand")
  let () = FS.delete (Path.of_string "${scratch}/bar.wand")
  let () = FS.delete (Path.of_string "${scratch}/baz.ml")
  in t.eq names ["bar.wand", "foo.wand"])

test "*.ml matches" (fn t ->
  let dir = Path.of_string scratch
  let () = FS.write_file "${scratch}/foo.wand" ""
  let () = FS.write_file "${scratch}/baz.ml" ""
  let names = FS.glob! *.ml dir |> List.map Path.basename |> List.sort
  let () = FS.delete (Path.of_string "${scratch}/foo.wand")
  let () = FS.delete (Path.of_string "${scratch}/baz.ml")
  in t.eq names ["baz.ml"])

test "no match" (fn t ->
  let dir = Path.of_string scratch
  let () = FS.write_file "${scratch}/foo.wand" ""
  let names = FS.glob! *.py dir |> List.map Path.basename |> List.sort
  let () = FS.delete (Path.of_string "${scratch}/foo.wand")
  in t.eq names [])

test "./* matches all" (fn t ->
  let dir = Path.of_string scratch
  let () = FS.write_file "${scratch}/foo.wand" ""
  let () = FS.write_file "${scratch}/bar.wand" ""
  let () = FS.write_file "${scratch}/baz.ml" ""
  let names = FS.glob! ./* dir |> List.map Path.basename |> List.sort
  let () = FS.delete (Path.of_string "${scratch}/foo.wand")
  let () = FS.delete (Path.of_string "${scratch}/bar.wand")
  let () = FS.delete (Path.of_string "${scratch}/baz.ml")
  in t.eq names ["bar.wand", "baz.ml", "foo.wand"])

test "** recursive" (fn t ->
  let dir = Path.of_string scratch
  let () = FS.mkdir (Path.of_string "${scratch}/sub")
  let () = FS.write_file "${scratch}/a.wand" ""
  let () = FS.write_file "${scratch}/sub/b.wand" ""
  let names = FS.glob! **.wand dir |> List.map Path.basename |> List.sort
  let () = FS.delete (Path.of_string "${scratch}/a.wand")
  let () = FS.delete (Path.of_string "${scratch}/sub/b.wand")
  let () = FS.delete (Path.of_string "${scratch}/sub")
  in t.eq names ["a.wand", "b.wand"])

test "cleanup scratch directory" (fn t ->
  let () = FS.delete (Path.of_string scratch)
  in t.ok true)
