uses {Shell}

let [test] = import Test
import String

let try_msg thunk =
  match try thunk () with
  | Ok _ -> ""
  | Error e -> e

(* ── Basic execution ($()) ─────────────────────────────────────────────── *)

test "captures stdout" (fn t -> t.eq "hello" $(echo hello))
test "strips trailing newline" (fn t -> t.eq "hello" $(printf hello))

(* A whole command in a value is shell source, so it goes in raw. Under
   `%{cmd}` it would be quoted into a single argument and `sh` would look
   for a program named "echo world". *)
test "dynamic cmd via raw interpolation" (fn t ->
  let cmd = "echo world" in t.eq "world" $(%!{cmd}))

test "result in binding" (fn t -> let out = $(echo hello) in t.eq "hello" out)

test "result in expression" (fn t -> let out = $(echo 3) in t.eq true (out == "3"))

test "interpolated command" (fn t -> let word = "hello" in t.eq "hello" $(echo %{word}))

(* ── Error handling ────────────────────────────────────────────────────── *)

test "raises on nonzero exit" (fn t -> t.raises (fn () -> $(exit 1)))
test "error shows exit code" (fn t ->
  t.ok (String.contains? "42" (try_msg (fn () -> $(sh -c "exit 42")))))

(* ── $?() ──────────────────────────────────────────────────────────────── *)

test "stdout field" (fn t -> let r = $?(echo hello) in t.eq "hello" r.stdout)

test "code zero" (fn t -> let r = $?(true) in t.eq 0 r.code)

test "code non-zero" (fn t -> let r = $?(false) in t.eq 1 r.code)

test "never raises" (fn t -> let r = $?(exit 42) in t.eq true (r.code == 42))

(* ── stdin via |> ──────────────────────────────────────────────────────── *)

test "pipe into cat" (fn t -> t.eq "hello" ("hello" |> $(cat)))
test "pipe into wc -w" (fn t -> t.eq "2" ("hello world" |> $(wc -w | tr -d " ")))

test "pipe into $?()" (fn t -> let r = "hello" |> $?(cat) in t.eq "hello" r.stdout)

(* ── mock handlers ─────────────────────────────────────────────────────── *)

test "mock process_run" (fn t ->
  let outcome =
    handle $(echo hello) with
    | Shell!run _ k -> k "mocked"
  in
  t.eq "mocked" outcome)
