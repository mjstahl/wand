uses {IO, Shell("echo real")}

import IO

let {test} = import Test

-- ── Default handler ─────────────────────────────────────────────────────

test "IO.print returns unit" (fn t -> t.eq 42 (IO.print "hi"; 42))
test "IO.println returns unit" (fn t -> t.eq 99 (IO.println "hi"; 99))

-- ── Sequencing ──────────────────────────────────────────────────────────

test "newline sequences" (fn t ->
  let outcome =
    handle (IO.print "a"; IO.print "b"; IO.print "c") with
    | IO!print s k -> s ++ k ()
    | return _ -> ""
  in
  t.eq "abc" outcome)

test "unit sequencing" (fn t -> t.eq 42 (IO.print "x"; 42))

-- ── Custom handlers ─────────────────────────────────────────────────────

test "collect prints" (fn t ->
  let outcome =
    handle (IO.print "hello"; IO.print " world") with
    | IO!print s k -> s ++ k ()
    | return _ -> ""
  in
  t.eq "hello world" outcome)

test "count prints" (fn t ->
  let outcome =
    handle (IO.print "a"; IO.print "b"; IO.print "c") with
    | IO!print _ k -> 1 + k ()
    | return _ -> 0
  in
  t.eq 3 outcome)

test "transform return value" (fn t ->
  let outcome =
    handle 42 with
    | return n -> n * 2
  in
  t.eq 84 outcome)

test "no effect cases needed" (fn t ->
  let outcome =
    handle 10 + 5 with
    | return n -> n
  in
  t.eq 15 outcome)

test "unhandled effect reaches default" (fn t ->
  let outcome =
    handle (IO.print "x"; 1) with
    | return n -> n
  in
  t.eq 1 outcome)

-- ── Pattern matching on effect args ────────────────────────────────────

test "literal match on arg" (fn t ->
  let outcome =
    handle (IO.print "hello"; IO.print "world") with
    | IO!print "hello" k -> "H" ++ k ()
    | IO!print s k -> s ++ k ()
    | return _ -> ""
  in
  t.eq "Hworld" outcome)

-- ── Process effect ──────────────────────────────────────────────────────

test "mock process" (fn t ->
  let outcome =
    handle $("echo real") with
    | Shell!run _ k -> k "mocked"
  in
  t.eq "mocked" outcome)

-- ── Type errors ─────────────────────────────────────────────────────────
