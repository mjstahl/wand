uses {Clock}

let {test, group} = import Test
import Clock
import Duration
import Test

-- Waiting is an effect, so a handler can answer it. That is what makes a
-- deadline testable instead of slow: `Test.with_clock` supplies a clock
-- that costs no time and reports what was asked of it.
--
-- Nothing here sleeps for real. A test that took the durations it names
-- would take over an hour.

group "the virtual clock" (fn () -> [
  test "an hour costs nothing" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> Clock.sleep 1h) in t.eq 1h elapsed),
  test "several sleeps add up" (fn t ->
    let (elapsed, v) =
      Test.with_clock (fn () ->
        let () = Clock.sleep 30s in let () = Clock.sleep 90s in "done")
    in
    t.eq (2min, "done") (elapsed, v)),
  test "a thunk that never sleeps waits no time" (fn t ->
    let (elapsed, v) = Test.with_clock (fn () -> 42) in t.eq (0ms, 42) (elapsed, v))
])

-- A zero sleep still performs the effect, so a handler sees it and a trace
-- reports it. Nothing is stepped around by a value that happens to be
-- zero.
group "the edges" (fn () -> [
  test "zero is still a sleep" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> Clock.sleep 0ms) in t.eq 0ms elapsed),
  test "and it is counted" (fn t ->
    let (elapsed, _) =
      Test.with_clock (fn () -> let () = Clock.sleep 0ms in Clock.sleep 5s)
    in
    t.eq 5s elapsed)
])

-- A backoff loop is the reason ordering had to come first.
let backoff attempts =
  let step d n =
    if n == 0 then 0ms
    else let capped = if d > 30s then 30s else d in
    let () = Clock.sleep capped in Duration.add capped (step (Duration.add d d) (n - 1))
  in step 1s attempts

group "a capped backoff" (fn () -> [
  test "doubles until the cap" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> backoff 3) in
    t.eq 7s elapsed),
    -- 1 + 2 + 4 + 8 + 16 + 30 + 30 + 30: the last three are the cap.
  test "and never sleeps longer than the cap" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> backoff 8) in
    t.eq 121s elapsed)
])
