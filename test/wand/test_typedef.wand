let {test} = import Test

(* ── Enum-style variants (no payload) ─────────────────────────────────── *)

type Color = Red | Green | Blue

test "nullary constructor" (fn t -> t.eq "Red" "%{Red}")
test "constructor equality" (fn t -> t.eq true (Red == Red))
test "constructor inequality" (fn t -> t.eq false (Red == Green))

(* ── Variants with payloads ────────────────────────────────────────────── *)

type Wrap = Wrap Int
type Pair = Pair Int Int

test "single payload" (fn t -> t.eq "Wrap(42)" "%{Wrap 42}")
test "two payloads" (fn t -> t.eq "Pair(3, 4)" "%{Pair 3 4}")

(* ── Pattern matching on variants ─────────────────────────────────────── *)

let describe_color c =
  match c with
  | Red -> "red"
  | Green -> "green"
  | Blue -> "blue"
test "match nullary" (fn t -> t.eq "green" (describe_color Green))

type Rect = Rect Int Int
let area r =
  match r with
  | Rect w h -> w * h
test "match payload" (fn t -> t.eq 12 (area (Rect 3 4)))

(* ── Single-constructor shorthand (named fields) ──────────────────────── *)

type Point(x: Int, y: Int)
type Circle(radius: Int)

test "construct and access" (fn t -> let p = Point(x = 1, y = 2) in t.eq 1 p.x)

test "second field" (fn t -> let origin = Point(x = 0, y = 0) in t.eq 0 origin.y)

test "field on function result" (fn t ->
  let unit_circle = Circle(radius = 1) in t.eq 1 unit_circle.radius)

(* ── Named constructor patterns ───────────────────────────────────────── *)

test "destructure named fields" (fn t ->
  let p = Point(x = 3, y = 4) in
  let sum =
    match p with
    | Point(x = a, y = b) -> a + b
  in
  t.eq 7 sum)

test "wildcard field" (fn t ->
  let p = Point(x = 5, y = 99) in
  let get_x =
    match p with
    | Point(x = v, y = _) -> v
  in
  t.eq 5 get_x)

let add_coords p = let Point(x = a, y = b) = p in a + b
test "in local let binding" (fn t -> t.eq 15 (add_coords Point(x = 7, y = 8)))

(* ── Named-field types are destructured by name ────────────────────────── *)

test "single field by name" (fn t ->
  let c = Circle(radius = 7) in let Circle(radius = r) = c in t.eq 7 r)

test "multi field by name" (fn t ->
  let p = Point(x = 3, y = 4) in let Point(x = a, y = b) = p in t.eq "3, 4" "%{a}, %{b}")

test "match case by name" (fn t ->
  let c = Circle(radius = 9) in
  (t.eq
    9
    (match c with
    | Circle(radius = r) -> r
    )))

let circle_area c = let Circle(radius = r) = c in r * r
test "in local let inside fn" (fn t -> t.eq 25 (circle_area Circle(radius = 5)))

(* ── Errors ────────────────────────────────────────────────────────────── *)

(* ── A type on a parameter ─────────────────────────────────────────────── *)

(* Dot access needs a named type, and a definition is generalized before any
   call is seen. So the type comes from the definition. *)

let radius_of (c: Circle) = c.radius
test "a parameter carries its type" (fn t -> t.eq 7 (radius_of Circle(radius = 7)))

let scaled (c: Circle) (by: Int) = c.radius * by
test "two annotated parameters" (fn t -> t.eq 21 (scaled Circle(radius = 7) 3))

test "a lambda takes one too" (fn t ->
  t.eq 12 ((fn (p: Point) -> p.x * p.y) Point(x = 3, y = 4)))

test "and an arm of a match" (fn t ->
  t.eq
    5
    (match Circle(radius = 5) with
    | (c: Circle) -> c.radius
    ))

let named (c: Circle) : Int = c.radius
test "with a return annotation as well" (fn t -> t.eq 2 (named Circle(radius = 2)))

(* ── Record update ────────────────────────────────────────────────────── *)

type Tally(ok: Int, failed: Int, label: String)

let base = Tally(ok = 1, failed = 2, label = "x")

test "one field changes and the rest stay" (fn t ->
  t.eq Tally(ok = 1, failed = 9, label = "x") Tally(base, failed = 9))
test "several fields at once" (fn t ->
  t.eq Tally(ok = 8, failed = 9, label = "x") Tally(base, ok = 8, failed = 9))
test "naming every field is a construction" (fn t ->
  t.eq Tally(ok = 8, failed = 9, label = "y") Tally(base, ok = 8, failed = 9, label = "y"))
test "the base is left alone" (fn t ->
  (let _ = Tally(base, failed = 9); t.eq 2 base.failed))
test "the base is any expression" (fn t ->
  t.eq 9 Tally(Tally(base, ok = 3), failed = 9).failed)

(* ── A type on a payload pattern ──────────────────────────────────────── *)

(* Where a decoder's result lands, so it is where the type is most often
   already known and most often still worth writing. *)
type Boxed(n: Int)

test "a payload carries its type" (fn t ->
  (
    let read =
      fn r -> match r with
        | Ok (b: Boxed) -> b.n
        | Error _ -> 0;
    t.eq 7 (read (Ok Boxed(n = 7)))
  ))

test "and so does one inside a tuple payload" (fn t ->
  (
    let read =
      fn r -> match r with
        | Ok ((b: Boxed), extra) -> b.n + extra
        | Error _ -> 0;
    t.eq 9 (read (Ok (Boxed(n = 7), 2)))
  ))
