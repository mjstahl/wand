let [test] = import Test

(* ── Enum-style variants (no payload) ─────────────────────────────────── *)

type Color = Red | Green | Blue

test "nullary constructor" (fn t -> t.eq "${Red}" "Red")
test "constructor equality" (fn t -> t.eq (Red == Red) true)
test "constructor inequality" (fn t -> t.eq (Red == Green) false)

(* ── Variants with payloads ────────────────────────────────────────────── *)

type Wrap = Wrap Int
type Pair = Pair Int Int

test "single payload" (fn t -> t.eq "${Wrap 42}" "Wrap(42)")
test "two payloads" (fn t -> t.eq "${Pair 3 4}" "Pair(3, 4)")

(* ── Pattern matching on variants ─────────────────────────────────────── *)

let describe_color c =
  match c with
  | Red -> "red"
  | Green -> "green"
  | Blue -> "blue"
test "match nullary" (fn t -> t.eq (describe_color Green) "green")

type Rect = Rect Int Int
let area r =
  match r with
  | Rect w h -> w * h
test "match payload" (fn t -> t.eq (area (Rect 3 4)) 12)

(* ── Single-constructor shorthand (named fields) ──────────────────────── *)

type Point = Point(x: Int, y: Int)
type Circle = Circle(radius: Int)

test "construct and access" (fn t -> let p = Point(x = 1, y = 2) in t.eq p.x 1)

test "second field" (fn t -> let origin = Point(x = 0, y = 0) in t.eq origin.y 0)

test "field on function result" (fn t ->
  let unit_circle = Circle(radius = 1) in t.eq unit_circle.radius 1)

(* ── Named constructor patterns ───────────────────────────────────────── *)

test "destructure named fields" (fn t ->
  let p = Point(x = 3, y = 4) in
  let sum = match p with
  | Point(x = a, y = b) -> a + b in
  t.eq sum 7)

test "wildcard field" (fn t ->
  let p = Point(x = 5, y = 99) in
  let get_x = match p with
  | Point(x = v, y = _) -> v in
  t.eq get_x 5)

let add_coords p = let Point(x = a, y = b) = p in a + b
test "in local let binding" (fn t -> t.eq (add_coords Point(x = 7, y = 8)) 15)

(* ── Named-field types are destructured by name ────────────────────────── *)

test "single field by name" (fn t ->
  let c = Circle(radius = 7) in let Circle(radius = r) = c in t.eq r 7)

test "multi field by name" (fn t ->
  let p = Point(x = 3, y = 4) in let Point(x = a, y = b) = p in t.eq "${a}, ${b}" "3, 4")

test "match arm by name" (fn t ->
  let c = Circle(radius = 9) in
  t.eq
    (match c with
    | Circle(radius = r) -> r)
    9)

let circle_area c = let Circle(radius = r) = c in r * r
test "in local let inside fn" (fn t -> t.eq (circle_area Circle(radius = 5)) 25)

(* ── Errors ────────────────────────────────────────────────────────────── *)
