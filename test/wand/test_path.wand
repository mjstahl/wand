let [test] = import Test
import Path

(* ── join ──────────────────────────────────────────────────────────────── *)

test "join absolute + segment" (fn t -> t.eq /usr/local/bin (Path.join /usr/local /bin))
test "join relative" (fn t -> t.eq ./foo/bar (Path.join ./foo /bar))
test "join nested" (fn t -> t.eq /var/log (Path.join /var /log))

(* ── parent / dirname ──────────────────────────────────────────────────── *)

test "parent" (fn t -> t.eq /usr/local (Path.parent /usr/local/bin))
test "dirname alias" (fn t -> t.eq /usr/local (Path.dirname /usr/local/bin))
test "parent top-level" (fn t -> t.eq (Path.of_string "/") (Path.parent /usr))

(* ── basename ──────────────────────────────────────────────────────────── *)

test "basename with ext" (fn t -> t.eq "wand" (Path.basename /usr/local/bin/wand))
test "basename file" (fn t -> t.eq "hosts" (Path.basename /etc/hosts))

(* ── extension ─────────────────────────────────────────────────────────── *)

test "extension dot txt" (fn t -> t.eq ".txt" (Path.extension /foo/bar.txt))
test "extension none" (fn t -> t.eq "" (Path.extension /foo/bar))
test "with_extension add" (fn t -> t.eq /foo/bar.ml (Path.with_extension ".ml" /foo/bar))
test "with_extension replace" (fn t ->
  t.eq /foo/bar.ml (Path.with_extension ".ml" /foo/bar.wand))

(* ── absolute? / relative? ───────────────────────────────────────── *)

test "absolute? /" (fn t -> t.ok (Path.absolute? /etc/hosts))
test "absolute? ./" (fn t -> t.eq false (Path.absolute? ./foo))
test "relative? ./" (fn t -> t.ok (Path.relative? ./foo))
test "relative? /" (fn t -> t.eq false (Path.relative? /usr))

(* ── normalize ─────────────────────────────────────────────────────────── *)

test "normalize double slash" (fn t -> t.eq /usr/local (Path.normalize /usr//local))
test "normalize dot component" (fn t -> t.eq /usr/local (Path.normalize /usr/./local))
test "normalize dotdot" (fn t -> t.eq /usr/bin (Path.normalize /usr/local/../bin))

(* ── to_string / of_string ────────────────────────────────────────────── *)

test "to_string" (fn t -> t.eq "/etc/hosts" (Path.to_string /etc/hosts))
test "of_string" (fn t -> t.eq "/etc/hosts" (Path.to_string (Path.of_string "/etc/hosts")))

(* ── components ────────────────────────────────────────────────────────── *)

test "components absolute" (fn t ->
  t.eq ["usr", "local", "bin"] (Path.components /usr/local/bin))
test "components relative" (fn t -> t.eq [".", "foo", "bar"] (Path.components ./foo/bar))
