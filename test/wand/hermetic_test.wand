import Test
import List
import String
import FS
import Path

(* A script whose real execution would push to production and rewrite a
   config. Every test below runs it, and neither happens. *)

let deploy () =
  let version = $(git describe --tags) in
  let () = FS.write_file! "/etc/app/config.toml" "version = \"${version}\"\n" in
  let _ = $(rsync -a ./build/ web@host:/srv/app) in
  "deployed ${version}"

(* Handlers compose: each holds back one family, so a script touching two
   needs both, nested. *)
let sealed thunk =
  Test.with_shell [("git describe", "v2.1.0")] (fn () -> Test.without_writes thunk)

(* ── It runs, against canned output ────────────────────────────────────── *)

test "runs to completion without the network" (fn t ->
  t.eq (sealed deploy) "deployed v2.1.0")

test "a command matching nothing answers empty" (fn t ->
  t.eq (Test.with_shell [] (fn () -> Test.without_writes deploy)) "deployed ")

(* ── What it attempted ─────────────────────────────────────────────────── *)

test "reports every command, in order" (fn t ->
  t.eq (Test.shell_calls (fn () -> Test.without_writes deploy))
       ["git describe --tags", "rsync -a ./build/ web@host:/srv/app"])

test "pushes exactly once" (fn t ->
  let cmds = Test.shell_calls (fn () -> Test.without_writes deploy) in
  t.eq (List.length (List.filter (fn c -> String.contains? "rsync" c) cmds)) 1)

test "reports what it would write" (fn t ->
  t.eq (Test.with_shell [] (fn () -> Test.writes deploy))
       ["/etc/app/config.toml"])

(* ── And nothing actually happened ─────────────────────────────────────── *)

test "the config was never written" (fn t ->
  let _ = sealed deploy in
  t.eq (FS.exists? (Path.of_string "/etc/app/config.toml")) false)
