let {test} = import Test
import String
import List
import Regex

-- ── Literals ────────────────────────────────────────────────────────────

test "regex has type Regex" (fn t -> let re = r/\d+/ in t.ok (Regex.match? re "abc123"))
test "regex literal inline" (fn t -> t.ok (Regex.match? r/hello/ "say hello"))

-- ── Regex.match? ───────────────────────────────────────────────────────

test "match found" (fn t -> t.ok (Regex.match? r/\d+/ "abc123"))
test "match not found" (fn t -> t.eq false (Regex.match? r/\d+/ "abc"))
test "match partial" (fn t -> t.ok (Regex.match? r/b/ "abc"))
test "match anchored" (fn t -> t.ok (Regex.match? r/^\d+$/ "123"))
test "match anchored fail" (fn t -> t.eq false (Regex.match? r/^\d+$/ "1a"))

-- ── Flags ───────────────────────────────────────────────────────────────

test "flags case-insensitive i" (fn t -> t.ok (Regex.match? r/hello/i "HELLO"))
test "flags case-insensitive miss without flag" (fn t ->
  t.eq false (Regex.match? r/hello/ "HELLO"))
test "flags multiline m - ^ matches line start" (fn t ->
  t.ok (Regex.match? r/^world/m "hello\nworld"))
test "flags dotall s - . matches newline" (fn t -> t.ok (Regex.match? r/a.b/s "a\nb"))
test "flags dotall off by default" (fn t -> t.eq false (Regex.match? r/a.b/ "a\nb"))

-- ── Regex.capture ──────────────────────────────────────────────────────

test "capture no match returns empty list" (fn t ->
  t.eq 0 (List.length (Regex.capture r/\d+/ "abc")))
test "capture full match at index 0" (fn t ->
  t.eq "123" (List.head! (Regex.capture r/\d+/ "abc123")))
test "capture groups" (fn t ->
  t.eq ["user@host", "user", "host"] (Regex.capture r/(\w+)@(\w+)/ "user@host"))
test "capture two groups" (fn t ->
  t.eq ["2026-05", "2026", "05"] (Regex.capture r/^(\d+)-(\d+)$/ "2026-05"))
test "capture pattern match on result" (fn t ->
  match Regex.capture r/^(\S+)\s+(\d+)/ "foo 42" with
  | [] -> t.eq "foo:42" "no match"
  | [_, name, num] -> t.eq "foo:42" "%{name}:%{num}"
  | _ -> t.eq "foo:42" "other")

-- ── Regex.replace ───────────────────────────────────────────────────

test "replace first match" (fn t -> t.eq "aXb2c3" (Regex.replace r/\d+/ "X" "a1b2c3"))
test "replace no match returns original" (fn t ->
  t.eq "abc" (Regex.replace r/\d+/ "X" "abc"))

-- ── Regex.replace_all ───────────────────────────────────────────────

test "replace_all matches" (fn t -> t.eq "aXbXcX" (Regex.replace_all r/\d+/ "X" "a1b2c3"))
test "replace_all no match returns original" (fn t ->
  t.eq "abc" (Regex.replace_all r/\d+/ "X" "abc"))
test "replace_all with empty string" (fn t ->
  t.eq "abc" (Regex.replace_all r/\s+/ "" "a b  c"))

-- ── Regex.split ─────────────────────────────────────────────────────

test "split_re on whitespace" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/\s+/ "a  b   c"))
test "split_re on delimiter" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/,\s*/ "a, b,c"))

-- ── Regex.match_all ────────────────────────────────────────────────────

test "match_all digit runs" (fn t ->
  t.eq ["1", "22", "333"] (Regex.match_all r/\d+/ "a1b22c333"))
test "match_all no matches" (fn t -> t.eq [] (Regex.match_all r/\d+/ "abc"))
test "match_all tokenizer-style alternation" (fn t ->
  let got = Regex.match_all r/[a-zA-Z_]\w*|[{}=]|"[^"]*"/ `block{x="1"}` in
  t.eq ["block", "{", "x", "=", `"1"`, "}"] got)

-- ── Regex module ────────────────────────────────────────────────────────

test "Regex.match?" (fn t -> t.ok (Regex.match? r/\d+/ "abc123"))
test "Regex.capture" (fn t -> t.eq ["123", "123"] (Regex.capture r/(\d+)/ "abc123"))
test "Regex.replace" (fn t -> t.eq "aXb2" (Regex.replace r/\d+/ "X" "a1b2"))
test "Regex.replace_all" (fn t -> t.eq "aXbX" (Regex.replace_all r/\d+/ "X" "a1b2"))
test "Regex.split" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/,/ "a,b,c"))

-- ── Regex.compile ───────────────────────────────────────────────────────

test "compile valid pattern" (fn t ->
  match Regex.compile "\\d+" with
  | Ok re -> t.eq true (Regex.match? re "abc123")
  | Error _ -> t.ok false)
test "compile invalid pattern returns Error" (fn t ->
  match Regex.compile "[invalid" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
