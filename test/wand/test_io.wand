uses {Proc}

import IO
import Proc

let {test} = import Test

test "IO.print_err" (fn t ->
  let outcome =
    handle let () = IO.print_err "error message" in "ok" with
    | IO!print_err _ k -> k ()
    | return s -> s
  in
  t.eq "ok" outcome)

test "IO.println_err" (fn t ->
  let outcome =
    handle let () = IO.println_err "error message" in "ok" with
    | IO!println_err _ k -> k ()
    | return s -> s
  in
  t.eq "ok" outcome)

test "IO.read_line mock" (fn t ->
  let outcome =
    handle IO.read_line! () with
    | IO!read_line _ k -> k "mocked line"
  in
  t.eq "mocked line" outcome)

test "IO.read_all mock" (fn t ->
  let outcome =
    handle IO.read_all! () with
    | IO!read_all _ k -> k "all of stdin"
  in
  t.eq "all of stdin" outcome)

test "IO.flush mock" (fn t ->
  let outcome =
    handle let () = IO.flush () in "flushed" with
    | IO!flush _ k -> k ()
    | return s -> s
  in
  t.eq "flushed" outcome)

(* ── Proc.exit ─────────────────────────────────────────────────────────── *)

let exit_poly_test () : Int = if true then 1 else Proc.exit 1
test "exit is polymorphic in return type" (fn t -> t.eq 1 (exit_poly_test ()))

(* ── Type errors ───────────────────────────────────────────────────────── *)
