import Test
import Types

(* ── Enum-style variants (no payload) ─────────────────────────────────── *)

type Color = Red | Green | Blue

test "nullary constructor" (fn t -> t.eq "${Red}" "Red")
test "constructor equality" (fn t -> t.eq (Red == Red) true)
test "constructor inequality" (fn t -> t.eq (Red == Green) false)

(* ── Variants with payloads ────────────────────────────────────────────── *)

type Wrap = Wrap Int
type Pair = Pair Int Int

test "single payload" (fn t -> t.eq "${Wrap 42}" "Wrap(42)")
test "two payloads" (fn t -> t.eq "${Pair 3 4}" "Pair(3, 4)")

(* ── Pattern matching on variants ─────────────────────────────────────── *)

let describe_color c = match c with
  | Red   -> "red"
  | Green -> "green"
  | Blue  -> "blue"
test "match nullary" (fn t -> t.eq (describe_color Green) "green")

type Rect = Rect Int Int
let area r = match r with
  | Rect w h -> w * h
test "match payload" (fn t -> t.eq (area (Rect 3 4)) 12)

(* ── Single-constructor shorthand (named fields) ──────────────────────── *)

type Point (x : Int, y : Int)
type Circle (radius : Int)

test "construct and access" (fn t ->
  let p = Point (x = 1, y = 2)
  in t.eq p.x 1)

test "second field" (fn t ->
  let origin = Point (x = 0, y = 0)
  in t.eq origin.y 0)

test "field on function result" (fn t ->
  let unit_circle = Circle (radius = 1)
  in t.eq unit_circle.radius 1)

(* ── Named constructor patterns ───────────────────────────────────────── *)

test "destructure named fields" (fn t ->
  let p = Point (x = 3, y = 4)
  let sum = match p with | Point (x = a, y = b) -> a + b
  in t.eq sum 7)

test "wildcard field" (fn t ->
  let p = Point (x = 5, y = 99)
  let get_x = match p with | Point (x = v, y = _) -> v
  in t.eq get_x 5)

let add_coords p =
  let Point (x = a, y = b) = p in
  a + b
test "in local let binding" (fn t -> t.eq (add_coords (Point (x = 7, y = 8))) 15)

(* ── Single-constructor shorthand destructuring ───────────────────────── *)

test "single field shorthand let" (fn t ->
  let c = Circle (radius = 7)
  let (r) = c
  in t.eq r 7)

test "multi field shorthand let" (fn t ->
  let p = Point (x = 3, y = 4)
  let (a, b) = p
  in t.eq "${a}, ${b}" "3, 4")

test "match arm shorthand" (fn t ->
  let c = Circle (radius = 9)
  in t.eq (match c with | (r) -> r) 9)

let circle_area c =
  let (r) = c in
  r * r
test "in local let inside fn" (fn t -> t.eq (circle_area (Circle (radius = 5))) 25)

test "unknown field in pattern" (fn t -> t.ok (Types.fails?
  "type Point (x : Int, y : Int)\nlet p = Point (x = 1, y = 2)\nlet sum = match p with | Point (x = a, z = b) -> a + b\nsum"))

(* ── Errors ────────────────────────────────────────────────────────────── *)

test "unknown constructor" (fn t -> t.ok (Types.fails? "Bogus"))
test "wrong arity" (fn t -> t.ok (Types.fails? "type Wrap = Wrap Int; Wrap 1 2"))
