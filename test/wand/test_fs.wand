uses {FS.Read, FS.Write}

let {test} = import Test
import FS
import Path
import List
import String

(* Real filesystem operations, self-contained: this file creates its own
   scratch directory (via FS.temp_file, so it can't collide with another
   run) and cleans up after itself, using FS.write_file/read_file as the
   trusted foundation (verified separately in test_fs.ml against an
   OCaml-managed temp file). *)

(* A unique name, borrowed from a temp file that the bracket removes on
   the way out -- so nothing is left behind and nothing has to remember. *)
let scratch = with FS.temp_file "wand_fs_test_" "" as p -> Path.to_string p
let () = FS.mkdir! (Path.of_string scratch)

test "temp_file gives a unique file that exists while it is held" (fn t ->
  let inner =
    with FS.temp_file "wand_" ".txt" as a ->
    with FS.temp_file "wand_" ".txt" as b -> (FS.exists? a, FS.exists? b, a != b)
  in
  t.eq (true, true, true) inner)

(* The point of the bracket: nobody has to remember the delete. *)
test "temp_file removes the file when the bracket ends" (fn t ->
  let p = with FS.temp_file "wand_" ".txt" as p -> p in t.eq false (FS.exists? p))

(* A body may publish the file by renaming it; cleanup then has nothing to
   do and must not fail on the way out. *)
test "temp_file tolerates the file being renamed away" (fn t ->
  let dst = Path.of_string "%{scratch}/published.txt" in
  let () = with FS.temp_file "wand_" ".txt" as p -> FS.rename! p dst in
  let published = FS.exists? dst in let () = FS.delete! dst in t.eq true published)

test "mkdir creates nested directories" (fn t ->
  let dir = Path.of_string "%{scratch}/mkdir_case/nested/deep" in
  let () = FS.mkdir! dir in
  let is_dir = FS.dir? dir in
  let () = FS.delete! dir in
  let () = FS.delete! (Path.of_string "%{scratch}/mkdir_case/nested") in
  let () = FS.delete! (Path.of_string "%{scratch}/mkdir_case") in t.ok is_dir)

test "create_file makes an empty file" (fn t ->
  let p = Path.of_string "%{scratch}/create_file_case.txt" in
  let () = FS.create_file! p in
  let contents = FS.read_file! p in let () = FS.delete! p in t.eq "" contents)

test "append writes to a real file on disk" (fn t ->
  let p = Path.of_string "%{scratch}/append_case.txt" in
  let () = FS.write_file! p "hello" in
  let () = FS.append! p " world" in
  let contents = FS.read_file! p in let () = FS.delete! p in t.eq "hello world" contents)

test "rename moves a file" (fn t ->
  let src = Path.of_string "%{scratch}/rename_src.txt" in
  let dst = Path.of_string "%{scratch}/rename_dst.txt" in
  let () = FS.write_file! src "data" in
  let () = FS.rename! src dst in
  let contents = FS.read_file! dst in let () = FS.delete! dst in t.eq "data" contents)

test "copy duplicates a file" (fn t ->
  let src = Path.of_string "%{scratch}/copy_src.txt" in
  let dst = Path.of_string "%{scratch}/copy_dst.txt" in
  let () = FS.write_file! src "copied" in
  let () = FS.copy! src dst in
  let contents = FS.read_file! dst in
  let () = FS.delete! src in let () = FS.delete! dst in t.eq "copied" contents)

test "exists?/file?/dir?" (fn t ->
  let p = Path.of_string "%{scratch}/exists_case.txt" in
  let () = FS.write_file! p "x" in
  let outcome = (FS.exists? p, FS.file? p, FS.dir? p) in
  let () = FS.delete! p in t.eq (true, true, false) outcome)

test "size returns the size" (fn t ->
  let p = Path.of_string "%{scratch}/size_case.txt" in
  let () = FS.write_file! p "12345" in
  let sz = FS.size! p in let () = FS.delete! p in t.eq 5B sz)

test "list_dir lists immediate children" (fn t ->
  let dir = Path.of_string "%{scratch}/list_dir_case" in
  let () = FS.mkdir! dir in
  let () = FS.write_file! (Path.of_string "%{scratch}/list_dir_case/a.txt") "a" in
  let () = FS.write_file! (Path.of_string "%{scratch}/list_dir_case/b.txt") "b" in
  let entries = FS.list_dir! dir in
  let names = List.sort (List.map (fn p -> Path.to_string (Path.basename p)) entries) in
  let () = FS.delete! (Path.of_string "%{scratch}/list_dir_case/a.txt") in
  let () = FS.delete! (Path.of_string "%{scratch}/list_dir_case/b.txt") in
  let () = FS.delete! dir in t.eq ["a.txt", "b.txt"] names)

(* `**` is the replacement for the removed FS.walk: it crosses directory
   separators and matches names without a dot, so `plain` below is included.
   `**.*` would silently drop it -- that is why the migration uses `**`. *)
test "glob ** recurses into subdirectories" (fn t ->
  let base = "%{scratch}/walk_case" in
  let () = FS.mkdir! (Path.of_string "%{base}/sub") in
  let () = FS.write_file! (Path.of_string "%{base}/a.txt") "a" in
  let () = FS.write_file! (Path.of_string "%{base}/sub/b.txt") "b" in
  let () = FS.write_file! (Path.of_string "%{base}/sub/plain") "p" in
  let entries = FS.glob_in ** (Path.of_string base) in
  let strip p =
    let s = Path.to_string p in String.slice (String.length base + 1) (String.length s) s
  in let names = List.sort (List.map strip entries) in
  let () = FS.delete! (Path.of_string "%{base}/a.txt") in
  let () = FS.delete! (Path.of_string "%{base}/sub/b.txt") in
  let () = FS.delete! (Path.of_string "%{base}/sub/plain") in
  let () = FS.delete! (Path.of_string "%{base}/sub") in
  let () = FS.delete! (Path.of_string base) in
  t.eq ["a.txt", "sub/b.txt", "sub/plain"] names)

test "delete removes a file" (fn t ->
  let p = Path.of_string "%{scratch}/delete_case.txt" in
  let () = FS.write_file! p "x" in let () = FS.delete! p in t.eq false (FS.exists? p))

test "read/write roundtrip" (fn t ->
  let p = Path.of_string "%{scratch}/roundtrip_case.txt" in
  let () = FS.write_file! p "round trip" in
  let contents = FS.read_file! p in let () = FS.delete! p in t.eq "round trip" contents)

test "read nonexistent file raises" (fn t ->
  t.raises (fn () -> FS.read_file! (Path.of_string "/no/such/path/wand_test_xyz")))

test "cwd returns an existing directory" (fn t -> t.ok (FS.dir? (FS.cwd ())))

test "cleanup scratch directory" (fn t ->
  let () = FS.delete! (Path.of_string scratch) in t.ok true)

(* ── type errors ───────────────────────────────────────────────────────── *)

(* ── effect handler mocking ────────────────────────────────────────────── *)

(* FS.append! performs an fs_append effect rather than touching the
   filesystem directly; a handler installed here intercepts it and
   resumes without ever writing to disk. *)
test "mock append does not touch real filesystem" (fn t ->
  let outcome =
    handle let () = FS.append! (Path.of_string "/dev/null") "data" in "done" with
    | FS!append _ k -> k ()
    | return s -> s
  in
  t.eq "done" outcome)

(* read_file/write_file perform bare `read_file`/`write_file` effects
   (no fs_ prefix, unlike the mutating ops above) -- mocking them the
   same way lets a test substitute fake file content/paths without
   touching disk at all. *)

test "mock read_file returns substituted content" (fn t ->
  let outcome =
    handle FS.read_file! (Path.of_string "/nonexistent") with
    | FS!read_file _ k -> k "mocked content"
  in
  t.eq "mocked content" outcome)

test "mock write_file resumes without touching disk" (fn t ->
  let outcome =
    handle let () = FS.write_file! (Path.of_string "/nonexistent") "data" in "done" with
    | FS!write_file _ k -> k ()
    | return s -> s
  in
  t.eq "done" outcome)

test "mock write_file can capture the path/content argument" (fn t ->
  let outcome =
    handle let () = FS.write_file! (Path.of_string "/tmp/foo.txt") "hello" in "wrote" with
    | FS!write_file (path, _) k -> Path.to_string path ++ ": ok" ++ k ()
    | return s -> s
  in
  t.eq "/tmp/foo.txt: okwrote" outcome)

(* ── Result payloads carry no source position ──────────────────────────── *)

(* The failing frame is inside FS.wand, so stamping its line/col onto the
   message would report a stdlib position to a caller holding the Result. *)
test "read_file error names the file, not a stdlib line" (fn t ->
  match FS.read_file (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "read_file:" e))

test "size error carries no position" (fn t ->
  match FS.size (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "size:" e))

(* ── whole trees ───────────────────────────────────────────────────────── *)

test "copy_tree carries the files under a directory" (fn t -> (
  let src = Path.of_string "%{scratch}/tree_src";
  let dst = Path.of_string "%{scratch}/tree_dst";
  FS.mkdir! src;
  FS.mkdir! (Path.of_string "%{scratch}/tree_src/inner");
  FS.write_file! (Path.of_string "%{scratch}/tree_src/inner/a.txt") "a";
  FS.copy_tree! src dst;
  let got = FS.read_file (Path.of_string "%{scratch}/tree_dst/inner/a.txt");
  FS.delete_tree! src;
  FS.delete_tree! dst;
  t.eq (Ok "a") got
))

test "delete_tree takes the directory with its contents" (fn t -> (
  let dir = Path.of_string "%{scratch}/doomed";
  FS.mkdir! dir;
  FS.write_file! (Path.of_string "%{scratch}/doomed/a.txt") "a";
  FS.delete_tree! dir;
  t.eq false (FS.exists? dir)
))

test "delete_tree on a path that is not there" (fn t ->
  match FS.delete_tree (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)

test "copy_tree error names the operation" (fn t ->
  match (FS.copy_tree
    (Path.of_string "/no/such/path/wand_test_xyz")
    (Path.of_string "%{scratch}/x")) with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "copy_tree:" e))
