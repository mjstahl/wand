uses {Clock, FS.Read, FS.Write, Shell(ln)}

let {test} = import Test
import FS
import Path
import List
import String
import Result
import Stream

-- Real filesystem operations, self-contained: this file creates its own
-- scratch directory (via FS.temp_file, so it can't collide with another
-- run) and cleans up after itself, using FS.write_file/read_file as the
-- trusted foundation (verified separately in test_fs.ml against an
-- OCaml-managed temp file).

-- A unique name, borrowed from a temp file that the bracket removes on
-- the way out -- so nothing is left behind and nothing has to remember.
let scratch = with FS.temp_file "wand_fs_test_" "" as p -> Path.to_string p
let () = FS.mkdir! (Path.of_string scratch)

test "temp_file gives a unique file that exists while it is held" (fn t ->
  let inner =
    with FS.temp_file "wand_" ".txt" as a ->
    with FS.temp_file "wand_" ".txt" as b -> (FS.exists? a, FS.exists? b, a != b)
  in
  t.eq (true, true, true) inner)

-- The point of the bracket: nobody has to remember the delete.
test "temp_file removes the file when the bracket ends" (fn t ->
  let p = with FS.temp_file "wand_" ".txt" as p -> p in t.eq false (FS.exists? p))

-- A body may publish the file by renaming it; cleanup then has nothing to
-- do and must not fail on the way out.
test "temp_file tolerates the file being renamed away" (fn t -> (
  let dst = Path.of_string "%{scratch}/published.txt";
  with FS.temp_file "wand_" ".txt" as p -> FS.rename! p dst;
  let published = FS.exists? dst;
  FS.delete! dst;
  t.eq true published
))

test "mkdir creates nested directories" (fn t -> (
  let dir = Path.of_string "%{scratch}/mkdir_case/nested/deep";
  FS.mkdir! dir;
  let is_dir = FS.dir? dir;
  FS.delete! dir;
  FS.delete! (Path.of_string "%{scratch}/mkdir_case/nested");
  FS.delete! (Path.of_string "%{scratch}/mkdir_case");
  t.ok is_dir
))

test "create_file makes an empty file" (fn t -> (
  let p = Path.of_string "%{scratch}/create_file_case.txt";
  FS.create_file! p;
  let contents = FS.read_file! p;
  FS.delete! p;
  t.eq "" contents
))

-- Publishing rather than filling: a reader sees the whole of one version or
-- the whole of the other. What the language level can check is that the
-- content arrives and that the directory is left with only the published
-- file in it -- the temp file goes beside the target, so a leak would show
-- up here.
test "write_atomic publishes a file and leaves no temp file" (fn t -> (
  let dir = Path.of_string "%{scratch}/atomic_case";
  FS.mkdir! dir;
  let p = Path.join dir ./published.conf;
  FS.write_atomic! p "one";
  FS.write_atomic! p "two";
  let contents = FS.read_file! p;
  let left = List.map Path.basename (FS.list_dir! dir);
  FS.delete_tree! dir;
  t.eq ("two", [./published.conf]) (contents, left)
))

-- One run at a time. What another process sees needs another process, and
-- test_fs.ml runs those; from here what is reachable is the guard against
-- this program's own second acquire, which is the same answer by design.
test "lock is held against a second acquire on the same path" (fn t -> (
  let p = Path.of_string "%{scratch}/guard.lock";
  let again = with FS.lock p as _ -> with FS.lock p as again -> again;
  FS.delete! p;
  t.eq (Error FS.Held) again
))

-- Two spellings of one file are one lock, so a guard cannot be walked past
-- by writing the path differently.
test "lock keys on the file, not the spelling" (fn t -> (
  let p = Path.of_string "%{scratch}/spelling.lock";
  let indirect = Path.of_string "%{scratch}/./spelling.lock";
  let again = with FS.lock p as _ -> with FS.lock indirect as again -> again;
  FS.delete! p;
  t.eq (Error FS.Held) again
))

-- Released when the bracket ends, so the next run gets it.
test "lock is given back when the bracket ends" (fn t -> (
  let p = Path.of_string "%{scratch}/serial.lock";
  let first = with FS.lock p as taken -> Result.ok? taken;
  let second = with FS.lock p as taken -> Result.ok? taken;
  FS.delete! p;
  t.eq (true, true) (first, second)
))

-- A lock that could not be asked for at all is a broken script, not a busy
-- one, and the two exit differently. Telling them apart is why the acquire
-- answers a Result.
test "a lock that cannot be opened is Denied, not Held" (fn t -> (
  let p = Path.of_string "%{scratch}/no_such_dir/x.lock";
  let outcome =
    (with FS.lock p as taken ->
     match taken with
     | Ok _ -> "took it"
     | Error (FS.Held) -> "held"
     | Error (FS.Denied _) -> "denied");
  t.eq "denied" outcome
))

-- A wait on a lock this same bracket holds can never end, so it is answered
-- now rather than after the budget. Ten seconds of budget, and this test
-- takes none of it: another worker would release, this will not.
test "a wait on a lock this bracket holds gives up at once" (fn t -> (
  let p = Path.of_string "%{scratch}/self_wait.lock";
  let again = with FS.lock p as _ -> with FS.lock_wait 10s p as again -> again;
  FS.delete! p;
  t.eq (Error FS.Held) again
))

-- A budget that runs out is Held, not a case of its own: waiting and being
-- told no says what being told no at once says.
test "a wait that runs out of budget is Held" (fn t -> (
  let p = Path.of_string "%{scratch}/budget.lock";
  let again = with FS.lock p as _ -> with FS.lock_wait 50ms p as again -> again;
  FS.delete! p;
  t.eq (Error FS.Held) again
))

-- A free lock is taken at once, so a budget is a bound and not a wait.
test "a wait on a free lock takes it" (fn t -> (
  let p = Path.of_string "%{scratch}/free_wait.lock";
  let taken = with FS.lock_wait 10s p as taken -> Result.ok? taken;
  FS.delete! p;
  t.eq true taken
))

-- A lock that cannot be opened ends the wait rather than spending it. Ten
-- seconds of budget against a directory that does not exist.
test "a wait on an impossible lock is Denied at once" (fn t -> (
  let p = Path.of_string "%{scratch}/no_such_dir/x.lock";
  let outcome =
    (with FS.lock_wait 10s p as taken ->
     match taken with
     | Ok _ -> "took it"
     | Error (FS.Held) -> "held"
     | Error (FS.Denied _) -> "denied");
  t.eq "denied" outcome
))

-- The lock file is never deleted. It looks like a leak and is the safe half
-- of the trade -- deleting it is the race the lock exists to prevent.
test "the lock file is left behind" (fn t -> (
  let p = Path.of_string "%{scratch}/kept.lock";
  let () = with FS.lock! p as _ -> ();
  let there = FS.exists? p;
  FS.delete! p;
  t.eq true there
))

-- The streaming publish. Same three properties as write_atomic, since it is
-- the same rename; what is its own is the ending.
test "write_lines_atomic publishes a stream and leaves no temp file" (fn t -> (
  let dir = Path.of_string "%{scratch}/atomic_lines";
  FS.mkdir! dir;
  let p = Path.join dir ./out.txt;
  FS.write_lines_atomic! p (Stream.of_list ["a", "b"]);
  let contents = FS.read_file! p;
  let left = List.map Path.basename (FS.list_dir! dir);
  FS.delete_tree! dir;
  t.eq ("a\nb\n", [./out.txt]) (contents, left)
))

-- The one thing only this form does. A stream that raises part way has
-- produced a file missing its tail, and publishing that would deliver a torn
-- file atomically -- which is what the operation exists to prevent. So the
-- temp file goes and the target still holds what it held.
--
-- `FS.write_lines` on the same stream leaves the target holding "a\n": the
-- old contents destroyed and the new ones incomplete.
test "a stream that raises publishes nothing" (fn t -> (
  let dir = Path.of_string "%{scratch}/atomic_lines_fail";
  FS.mkdir! dir;
  let p = Path.join dir ./out.txt;
  FS.write_file! p "old";
  let boom = fn line -> if line == "b" then List.head! [] else line;
  let attempt = try Stream.of_list ["a", "b"] |> Stream.map boom |> FS.write_lines_atomic! p;
  let contents = FS.read_file! p;
  let left = List.map Path.basename (FS.list_dir! dir);
  FS.delete_tree! dir;
  t.eq (true, "old", [./out.txt]) (Result.error? attempt, contents, left)
))

test "append writes to a real file on disk" (fn t -> (
  let p = Path.of_string "%{scratch}/append_case.txt";
  FS.write_file! p "hello";
  FS.append! p " world";
  let contents = FS.read_file! p;
  FS.delete! p;
  t.eq "hello world" contents
))

test "rename moves a file" (fn t -> (
  let src = Path.of_string "%{scratch}/rename_src.txt";
  let dst = Path.of_string "%{scratch}/rename_dst.txt";
  FS.write_file! src "data";
  FS.rename! src dst;
  let contents = FS.read_file! dst;
  FS.delete! dst;
  t.eq "data" contents
))

test "copy duplicates a file" (fn t -> (
  let src = Path.of_string "%{scratch}/copy_src.txt";
  let dst = Path.of_string "%{scratch}/copy_dst.txt";
  FS.write_file! src "copied";
  FS.copy! src dst;
  let contents = FS.read_file! dst;
  FS.delete! src;
  FS.delete! dst;
  t.eq "copied" contents
))

test "exists?/file?/dir?" (fn t -> (
  let p = Path.of_string "%{scratch}/exists_case.txt";
  FS.write_file! p "x";
  let outcome = (FS.exists? p, FS.file? p, FS.dir? p);
  FS.delete! p;
  t.eq (true, true, false) outcome
))

test "size returns the size" (fn t -> (
  let p = Path.of_string "%{scratch}/size_case.txt";
  FS.write_file! p "12345";
  let sz = FS.size! p;
  FS.delete! p;
  t.eq 5B sz
))

test "list_dir lists immediate children" (fn t -> (
  let dir = Path.of_string "%{scratch}/list_dir_case";
  FS.mkdir! dir;
  FS.write_file! (Path.of_string "%{scratch}/list_dir_case/a.txt") "a";
  FS.write_file! (Path.of_string "%{scratch}/list_dir_case/b.txt") "b";
  let entries = FS.list_dir! dir;
  let names = List.sort (List.map (fn p -> Path.to_string (Path.basename p)) entries);
  FS.delete! (Path.of_string "%{scratch}/list_dir_case/a.txt");
  FS.delete! (Path.of_string "%{scratch}/list_dir_case/b.txt");
  FS.delete! dir;
  t.eq ["a.txt", "b.txt"] names
))

-- `**` is the replacement for the removed FS.walk: it crosses directory
-- separators and matches names without a dot, so `plain` below is included.
-- `**.*` would silently drop it -- that is why the migration uses `**`.
test "glob ** recurses into subdirectories" (fn t -> (
  let base = "%{scratch}/walk_case";
  FS.mkdir! (Path.of_string "%{base}/sub");
  FS.write_file! (Path.of_string "%{base}/a.txt") "a";
  FS.write_file! (Path.of_string "%{base}/sub/b.txt") "b";
  FS.write_file! (Path.of_string "%{base}/sub/plain") "p";
  let entries = FS.glob_in ** (Path.of_string base);
  let strip p =
    let s = Path.to_string p in String.slice (String.length base + 1) (String.length s) s;
  let names = List.sort (List.map strip entries);
  FS.delete! (Path.of_string "%{base}/a.txt");
  FS.delete! (Path.of_string "%{base}/sub/b.txt");
  FS.delete! (Path.of_string "%{base}/sub/plain");
  FS.delete! (Path.of_string "%{base}/sub");
  FS.delete! (Path.of_string base);
  t.eq ["a.txt", "sub/b.txt", "sub/plain"] names
))

test "delete removes a file" (fn t -> (
  let p = Path.of_string "%{scratch}/delete_case.txt";
  FS.write_file! p "x";
  FS.delete! p;
  t.eq false (FS.exists? p)
))

test "read/write roundtrip" (fn t -> (
  let p = Path.of_string "%{scratch}/roundtrip_case.txt";
  FS.write_file! p "round trip";
  let contents = FS.read_file! p;
  FS.delete! p;
  t.eq "round trip" contents
))

test "read nonexistent file raises" (fn t ->
  t.raises (fn () -> FS.read_file! (Path.of_string "/no/such/path/wand_test_xyz")))

test "cwd returns an existing directory" (fn t -> t.ok (FS.dir? (FS.cwd ())))

test "cleanup scratch directory" (fn t -> (FS.delete! (Path.of_string scratch); t.ok true))

-- ── type errors ─────────────────────────────────────────────────────────

-- ── effect handler mocking ──────────────────────────────────────────────

-- FS.append! performs an fs_append effect rather than touching the
-- filesystem directly; a handler installed here intercepts it and
-- resumes without ever writing to disk.
test "mock append does not touch real filesystem" (fn t ->
  let outcome =
    handle (FS.append! (Path.of_string "/dev/null") "data"; "done") with
    | FS!append _ k -> k ()
    | return s -> s
  in
  t.eq "done" outcome)

-- read_file/write_file perform bare `read_file`/`write_file` effects
-- (no fs_ prefix, unlike the mutating ops above) -- mocking them the
-- same way lets a test substitute fake file content/paths without
-- touching disk at all.

test "mock read_file returns substituted content" (fn t ->
  let outcome =
    handle FS.read_file! (Path.of_string "/nonexistent") with
    | FS!read_file _ k -> k "mocked content"
  in
  t.eq "mocked content" outcome)

test "mock write_file resumes without touching disk" (fn t ->
  let outcome =
    handle (FS.write_file! (Path.of_string "/nonexistent") "data"; "done") with
    | FS!write_file _ k -> k ()
    | return s -> s
  in
  t.eq "done" outcome)

test "mock write_file can capture the path/content argument" (fn t ->
  let outcome =
    handle (FS.write_file! (Path.of_string "/tmp/foo.txt") "hello"; "wrote") with
    | FS!write_file (path, _) k -> Path.to_string path ++ ": ok" ++ k ()
    | return s -> s
  in
  t.eq "/tmp/foo.txt: okwrote" outcome)

-- ── Result payloads carry no source position ────────────────────────────

-- The failing frame is inside FS.wand, so stamping its line/col onto the
-- message would report a stdlib position to a caller holding the Result.
test "read_file error names the file, not a stdlib line" (fn t ->
  match FS.read_file (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "read_file:" e))

test "size error carries no position" (fn t ->
  match FS.size (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "size:" e))

-- ── whole trees ─────────────────────────────────────────────────────────

test "copy_tree carries the files under a directory" (fn t -> (
  let src = Path.of_string "%{scratch}/tree_src";
  let dst = Path.of_string "%{scratch}/tree_dst";
  FS.mkdir! src;
  FS.mkdir! (Path.of_string "%{scratch}/tree_src/inner");
  FS.write_file! (Path.of_string "%{scratch}/tree_src/inner/a.txt") "a";
  FS.copy_tree! src dst;
  let got = FS.read_file (Path.of_string "%{scratch}/tree_dst/inner/a.txt");
  FS.delete_tree! src;
  FS.delete_tree! dst;
  t.eq (Ok "a") got
))

test "delete_tree takes the directory with its contents" (fn t -> (
  let dir = Path.of_string "%{scratch}/doomed";
  FS.mkdir! dir;
  FS.write_file! (Path.of_string "%{scratch}/doomed/a.txt") "a";
  FS.delete_tree! dir;
  t.eq false (FS.exists? dir)
))

test "delete_tree on a path that is not there" (fn t ->
  match FS.delete_tree (Path.of_string "/no/such/path/wand_test_xyz") with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)

test "copy_tree error names the operation" (fn t ->
  match (FS.copy_tree
    (Path.of_string "/no/such/path/wand_test_xyz")
    (Path.of_string "%{scratch}/x")) with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.starts_with? "copy_tree:" e))

-- ── What a name is, and what it points at ───────────────────────────────

-- wand has no way to make a symlink, so `ln -s` makes them. What is under
-- test is what `delete` and `copy_tree` do when they meet one.

-- `delete` removes the name it is given. It used to ask `Sys.is_directory`,
-- which follows a link, so a symlink to a directory was handed to `rmdir` --
-- which got the link and answered "Not a directory".
test "delete removes a link to a directory, not the directory" (fn t -> (
  let dir = Path.of_string "%{scratch}/link_target";
  let link = Path.of_string "%{scratch}/link_to_dir";
  FS.mkdir! dir;
  let _ = $(ln -s %{dir} %{link});
  let removed = FS.delete link;
  let kept = FS.dir? dir;
  FS.delete! dir;
  t.eq (true, true) (Result.ok? removed, kept)
))

-- Copying a tree twice is an ordinary thing to do, and it failed when the
-- tree held a link pointing nowhere: the existence check followed the link,
-- answered "not there", and `symlink` then refused the name it had just
-- been told was free.
test "copy_tree runs twice over a dangling link" (fn t -> (
  let src = Path.of_string "%{scratch}/ct_src";
  let dst = Path.of_string "%{scratch}/ct_dst";
  let dangling = Path.of_string "%{scratch}/ct_src/dangling";
  FS.mkdir! src;
  FS.write_file! (Path.of_string "%{scratch}/ct_src/a.txt") "a\n";
  let _ = $(ln -s /nowhere/at/all %{dangling});
  FS.copy_tree! src dst;
  let again = FS.copy_tree src dst;
  FS.delete_tree! src;
  FS.delete_tree! dst;
  t.eq true (Result.ok? again)
))
