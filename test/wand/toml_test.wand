import Test
import TOML
import List
import Map
import Path
import FS

(* ── parse ─────────────────────────────────────────────────────────────── *)

test "valid TOML returns Ok" (fn t -> t.eq (match TOML.parse "key = \"value\"\n" with
| Ok _ -> "ok"
| Error _ -> "error") "ok")

test "invalid TOML returns Error" (fn t -> t.eq (match TOML.parse "not = = toml" with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "parse! valid" (fn t -> let tm = TOML.parse! "x = 1\n" in t.eq (TOML.table? tm) true)

test "parse! invalid raises" (fn t -> t.raises (fn () -> TOML.parse! "bad = = toml"))

(* ── field / field! ────────────────────────────────────────────────────── *)

test "field exists" (fn t -> let tm = TOML.parse! "name = \"Alice\"\nage = 30\n" in
t.eq (match TOML.field "name" tm with
| Ok v -> TOML.get_string v
| Error _ -> Error "no field") (Ok "Alice"))

test "field missing" (fn t -> let tm = TOML.parse! "a = 1\n" in
t.eq (match TOML.field "z" tm with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "field! exists" (fn t -> let tm = TOML.parse! "x = 42\n" in
t.eq (match TOML.get_int (TOML.field! "x" tm) with
| Ok n -> n
| Error _ -> -1) 42)

test "field! missing raises" (fn t -> let tm = TOML.parse! "a = 1\n" in t.raises (fn () -> TOML.field! "z" tm))

(* ── get_* extractors ──────────────────────────────────────────────────── *)

test "get_string" (fn t -> let tm = TOML.parse! "s = \"hello\"\n" in
t.eq (match TOML.get_string (TOML.field! "s" tm) with
| Ok s -> s
| Error _ -> "") "hello")

test "get_int" (fn t -> let tm = TOML.parse! "n = 99\n" in
t.eq (match TOML.get_int (TOML.field! "n" tm) with
| Ok n -> n
| Error _ -> -1) 99)

test "get_float" (fn t -> let tm = TOML.parse! "f = 3.14\n" in
t.eq (match TOML.get_float (TOML.field! "f" tm) with
| Ok f -> f > 3.0
| Error _ -> false) true)

test "get_float from int" (fn t -> let tm = TOML.parse! "n = 2\n" in
t.eq (match TOML.get_float (TOML.field! "n" tm) with
| Ok f -> f == 2.0
| Error _ -> false) true)

test "get_bool true" (fn t -> let tm = TOML.parse! "flag = true\n" in
t.eq (match TOML.get_bool (TOML.field! "flag" tm) with
| Ok b -> b
| Error _ -> false) true)

test "get_array length" (fn t -> let tm = TOML.parse! "nums = [1, 2, 3]\n" in
t.eq (match TOML.get_array (TOML.field! "nums" tm) with
| Ok xs -> List.length xs
| Error _ -> -1) 3)

test "get_array int elements" (fn t -> let tm = TOML.parse! "nums = [10, 20]\n" in
t.eq (match TOML.get_array (TOML.field! "nums" tm) with
| Ok xs -> (match TOML.get_int (List.head! xs) with
| Ok n -> n
| Error _ -> -1)
| Error _ -> -1) 10)

(* ── nested tables ─────────────────────────────────────────────────────── *)

test "nested table access" (fn t -> let src = "[server]\nhost = \"localhost\"\nport = 8080\n" in
let tm = TOML.parse! src in
let server = TOML.field! "server" tm in
t.eq (match TOML.get_string (TOML.field! "host" server) with
| Ok s -> s
| Error _ -> "") "localhost")

(* ── get_table ─────────────────────────────────────────────────────────── *)

test "get_table returns Map" (fn t -> let tm = TOML.parse! "a = 1\nb = 2\n" in
t.eq (match TOML.get_table tm with
| Ok m -> Map.size m
| Error _ -> -1) 2)

(* ── read_file ─────────────────────────────────────────────────────────── *)

test "read_file ok" (fn t -> let p = FS.temp_file! "wand_toml_rd_" ".toml" in
let () = FS.write_file! (Path.to_string p) "[db]\nname = \"mydb\"\n" in
let outcome = match TOML.read_file p with
| Ok tm -> (let db = TOML.field! "db" tm in
match TOML.get_string (TOML.field! "name" db) with
| Ok s -> s
| Error _ -> "")
| Error _ -> "" in
let () = FS.delete! p in t.eq outcome "mydb")

test "read_file missing file returns Error" (fn t -> t.eq (match TOML.read_file (Path.of_string "/nonexistent/wand_missing.toml") with
| Ok _ -> "ok"
| Error _ -> "error") "error")
