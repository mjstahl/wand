import Test
import Env
import List
import Path
import String
import Map
import FS

(* ── get ───────────────────────────────────────────────────────────────── *)

let () = Env.set "WAND_TEST_VAR" "hello"
test "get existing" (fn t -> t.eq (Env.get "WAND_TEST_VAR") (Some "hello"))
test "get missing returns None" (fn t -> t.eq (Env.get "WAND_TEST_NONEXISTENT_XYZ") None)

(* ── get! ──────────────────────────────────────────────────────────────── *)

let () = Env.set "WAND_TEST_VAR" "world"
test "get! existing" (fn t -> t.eq (Env.get! "WAND_TEST_VAR") "world")
test "get! missing raises" (fn t -> t.raises (fn () -> Env.get! "WAND_TEST_NONEXISTENT_XYZ"))

(* ── set ───────────────────────────────────────────────────────────────── *)

test "set then get" (fn t -> let () = Env.set "WAND_TEST_SET" "value" in t.eq (Env.get "WAND_TEST_SET") (Some "value"))

(* ── clear ─────────────────────────────────────────────────────────────── *)

let () = Env.set "WAND_TEST_CLEAR" "before"
test "clear empties value" (fn t -> let () = Env.clear "WAND_TEST_CLEAR" in t.eq (Env.get "WAND_TEST_CLEAR") (Some ""))

(* ── all ───────────────────────────────────────────────────────────────── *)

let () = Env.set "WAND_TEST_ALL" "present"
test "all contains set var" (fn t -> let pairs = Env.all () in t.ok (List.any (fn (k, _) -> k == "WAND_TEST_ALL") pairs))

(* ── args ──────────────────────────────────────────────────────────────── *)

test "args returns list" (fn t -> t.ok (List.empty? (Env.args ()) == false || true))

(* ── home ──────────────────────────────────────────────────────────────── *)

test "home returns path" (fn t -> t.ok (Path.absolute? (Env.home ())))

(* ── user ──────────────────────────────────────────────────────────────── *)

test "user returns non-empty string" (fn t -> t.ok (String.length (Env.user ()) > 0))

(* ── Env.read / Env.load ──────────────────────────────────────────────── *)

test "basic key=value" (fn t -> let p = FS.temp_file! "wand_env_rd_" ".env" in
let () = FS.write_file! (Path.to_string p) "FOO=bar\nBAZ=qux\n" in
let m = Env.read p in let () = FS.delete! p in t.eq (Map.get! "FOO" m) "bar")

let dotenv_fmt =
  "# comment\nKEY1=hello\nKEY2=\"quoted\"\nKEY3='single'\nexport KEY4=exported\n\nKEY5=has=equals\n"

test "dotenv formats" (fn t -> let p = FS.temp_file! "wand_env_fmt_" ".env" in
let () = FS.write_file! (Path.to_string p) dotenv_fmt in
let m = Env.read p in
let () = FS.delete! p in
t.eq (Map.get! "KEY1" m, Map.get! "KEY2" m, Map.get! "KEY3" m, Map.get! "KEY4" m, Map.get! "KEY5" m) ("hello", "quoted", "single", "exported", "has=equals"))

test "load sets env var" (fn t -> let p = FS.temp_file! "wand_load_" ".env" in
let () = FS.write_file! (Path.to_string p) "WAND_LOAD_TEST=loaded_value\n" in
let () = Env.load p in
let outcome = Env.get "WAND_LOAD_TEST" in
let () = FS.delete! p in t.eq outcome (Some "loaded_value"))
