let {test, group} = import Test
import List
import Path

-- What wand orders, and on what.
--
-- `<`, `>`, `<=` and `>=` take an `Ord`: a type wand knows how to order.
-- The constraint is what makes a type outside that set a type error rather
-- than a failure during the run.
--
-- Every comparison is on the normalized value. The stored text is not the
-- value: `1min` and `60s` are one duration, and one instant has as many
-- spellings as there are offsets.

group "the types that were always ordered" (fn () -> [
  test "Int" (fn t -> t.ok (1 < 2)),
  test "Float" (fn t -> t.ok (2.5 >= 2.5)),
  test "String" (fn t -> t.ok ("b" > "a"))
])

group "Duration" (fn () -> [
  test "across units" (fn t -> t.ok (30s < 5min)),
  test "the larger unit is not the larger value" (fn t -> t.ok (90s > 1min)),
  test "milliseconds against seconds" (fn t -> t.ok (30s <= 30000ms))
])

group "instants" (fn () -> [
  test "a later date" (fn t -> t.ok (2024-01-15T00:00:00Z < 2024-02-01T00:00:00Z)),
  test "across a year" (fn t -> t.ok (2023-12-31T00:00:00Z < 2024-01-01T00:00:00Z)),
  test "a later time of day" (fn t -> t.ok (2024-01-15T14:30:00Z < 2024-01-15T15:00:00Z)),
  test "to the second" (fn t -> t.ok (2024-01-15T14:30:00Z < 2024-01-15T14:30:01Z)),
  -- A bare day is midnight, so it sorts before every instant in it.
  test "a day comes before the day it opens" (fn t ->
    t.ok (2024-01-15T00:00:00Z < 2024-01-15T00:00:01Z))
])

group "DateTime is an instant" (fn () -> [
  test "same day" (fn t -> t.ok (2024-01-15T14:30:00Z < 2024-01-15T20:00:00Z)),
  -- The offset is part of the value. These two are the same moment.
  test "an offset is applied" (fn t ->
    t.ok (2024-01-15T20:00:00+05:30 == 2024-01-15T14:30:00Z)),
  test "and it decides the order" (fn t ->
    t.ok (2024-01-15T00:00:00-08:00 > 2024-01-15T00:00:00Z)),
  test "midnight rolls the day" (fn t -> t.ok (2024-02-29T23:00:00Z < 2024-03-01T01:00:00Z)),
  -- A value with no offset is read as UTC.
  test "no offset is UTC" (fn t -> t.ok (2024-01-15T14:30:00 == 2024-01-15T14:30:00Z))
])

-- One file has several spellings, so a comparison reads the path rather
-- than the text. Only the rewrites that hold whatever the disk contains:
-- `..` is left alone, because `/a/c/../b` is `/a/b` only while `c` is not a
-- symlink.
group "paths" (fn () -> [
  test "repeated separators are one" (fn t -> t.ok (/a/b == /a//b)),
  test "a dot segment is nothing" (fn t -> t.ok (/a/b == /a/./b)),
  test "a trailing separator is nothing" (fn t -> t.ok (/a/b == /a/b/)),
  test "a leading dot segment is nothing" (fn t ->
    t.ok (Path.of_string "./b" == Path.of_string "b")),
  test "and the order follows" (fn t -> t.ok (/a//a < /a/b)),
  test "which sorts them" (fn t ->
    t.eq [/a/a, /a/b, /a/c] (List.sort [/a/c, /a//a, /a/./b])),
  -- The three that would claim more than a comparison can know.
  test "'..' is not resolved" (fn t -> t.ok (/a/c/../b != /a/b)),
  test "case is not folded" (fn t -> t.ok (/A/b != /a/b)),
  test "a relative path is not made absolute" (fn t -> t.ok (./b != /b)),
  -- The value keeps the spelling it was written with.
  test "the text is unchanged" (fn t -> t.eq "/a//b" (Path.to_string /a//b))
])

group "equality agrees with ordering" (fn () -> [
  test "a duration written two ways" (fn t ->
    let a = 60s in let b = 1min in t.ok (a == b && !(a < b) && !(a > b))),
  test "an instant written two ways" (fn t ->
    let a = 2024-01-15T14:30:00Z in
    let b = 2024-01-15T20:00:00+05:30 in t.ok (a == b && !(a < b) && !(a > b))),
  test "a path written two ways" (fn t ->
    let a = /a/b in let b = /a//b in t.ok (a == b && !(a < b) && !(a > b)))
])

-- `Ord` composes like `Num`: a function that only compares stays
-- polymorphic over every ordered type.
let later a b = if a < b then b else a
group "Ord is a constraint, not a type" (fn () -> [
  test "at Duration" (fn t -> t.eq 5min (later 30s 5min)),
  test "at Int" (fn t -> t.eq 9 (later 9 2)),
  test "at Date" (fn t ->
    t.eq 2024-02-01T00:00:00Z (later 2024-01-15T00:00:00Z 2024-02-01T00:00:00Z))
])

-- The four whose text order is not their value order. Each line below is a
-- case where comparing the spelling gives the wrong answer.

group "Size" (fn () -> [
  test "across units" (fn t -> t.ok (100MB < 1GB)),
  test "a bigger number in a smaller unit" (fn t -> t.ok (1GB > 999MB)),
  -- A KB is 1000 bytes: the spelling is the SI one.
  test "the unit is decimal" (fn t -> t.ok (1KB == 1000B)),
  test "a decimal literal" (fn t -> t.ok (1.5GB == 1500000000B))
])

group "Version" (fn () -> [
  test "ten is above nine" (fn t -> t.ok (1.10.0 > 1.9.0)),
  test "patch" (fn t -> t.ok (1.2.3 < 1.2.10)),
  test "a prerelease is below its release" (fn t -> t.ok (1.2.3-rc.1 < 1.2.3)),
  test "numeric identifiers compare as numbers" (fn t ->
    t.ok (1.2.3-alpha.2 > 1.2.3-alpha.1)),
  test "a number is below a word" (fn t -> t.ok (1.2.3-1 < 1.2.3-alpha)),
  test "words compare as text" (fn t -> t.ok (1.2.3-alpha < 1.2.3-beta)),
  test "more identifiers wins when the rest match" (fn t ->
    t.ok (1.2.3-alpha < 1.2.3-alpha.1))
])

group "Port and IPv4" (fn () -> [
  test "a port is its number" (fn t -> t.ok (:80 < :443)),
  test "an address is its 32 bits" (fn t -> t.ok (10.0.0.9 < 10.0.0.10)),
  test "across octets" (fn t -> t.ok (10.0.1.0 > 10.0.0.255)),
  test "a padded octet is the same address" (fn t -> t.ok (192.168.001.1 == 192.168.1.1))
])

-- A network reads as numbers too. Compared as text, `10.0.0.0/8` sat below
-- `9.0.0.0/8` -- the same two addresses the other way round from what the
-- addresses themselves answer.
group "CIDR" (fn () -> [
  test "where the network starts decides first" (fn t -> t.ok (9.0.0.0/8 < 10.0.0.0/8)),
  test "then how far it reaches" (fn t -> t.ok (10.0.0.0/8 < 10.0.0.0/16)),
  test "a network equals itself" (fn t -> t.ok (10.0.0.0/8 == 10.0.0.0/8)),
  test "sorted" (fn t ->
    t.eq
      [9.0.0.0/8, 10.0.0.0/8, 10.0.0.0/16]
      (List.sort [10.0.0.0/16, 10.0.0.0/8, 9.0.0.0/8]))
])

-- A type wand does not order still sorts, because `List.sort` takes a list
-- of anything. What decides is the declaration: a constructor sorts where it
-- was written, not where its name falls in the alphabet.
type Prio = Low | Medium | High

type S = Zulu | Alpha

group "a variant sorts by its declaration" (fn () -> [
  test "in the order written" (fn t ->
    t.eq [Low, Medium, High] (List.sort [High, Low, Medium])),
  test "not by name" (fn t -> t.eq [Zulu, Alpha] (List.sort [Alpha, Zulu])),
  test "inside a tuple" (fn t ->
    t.eq [(0, Zulu), (1, Zulu), (1, Alpha)] (List.sort [(1, Alpha), (0, Zulu), (1, Zulu)])),
  test "inside a list" (fn t -> t.eq [[Zulu], [Alpha]] (List.sort [[Alpha], [Zulu]])),
  test "the payload breaks a tie" (fn t ->
    t.eq [Some 1, Some 2] (List.sort [Some 2, Some 1])),
  -- The built-in pairs declare their absent and failed cases first.
  test "None before Some" (fn t -> t.eq [None, Some 1] (List.sort [Some 1, None])),
  test "Error before Ok" (fn t -> t.eq [Error "e", Ok 1] (List.sort [Ok 1, Error "e"]))
])
