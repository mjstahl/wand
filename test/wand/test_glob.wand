uses {FS.Read, FS.Write}

let [test] = import Test
import FS
import Path
import List

(* Glob literal syntax (`*.wand`, `**`, `./**/*.ml`, ...) is a distinct
   token/type from Path -- raw lexer-level assertions for that stay in
   test_glob.ml (no wand-source equivalent). This file covers the type
   and the real FS.glob/FS.glob_in behavior. *)

test "glob literal type" (fn t -> let g = *.wand in t.ok true)

(* ── FS.glob ──────────────────────────────────────────────────────────── *)

(* A unique name, borrowed from a temp file that the bracket removes on
   the way out -- so nothing is left behind and nothing has to remember. *)
let scratch = with FS.temp_file "wand_glob_test_" "" as p -> Path.to_string p
let () = FS.mkdir! (Path.of_string scratch)

test "*.wand matches" (fn t ->
  let dir = Path.of_string scratch in
  let () = FS.write_file! (Path.of_string "%{scratch}/foo.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/bar.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/baz.ml") "" in
  let names =
    FS.glob_in *.wand dir
      |> List.map (fn p -> Path.to_string (Path.basename p))
      |> List.sort
  in
  let () = FS.delete! (Path.of_string "%{scratch}/foo.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/bar.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/baz.ml") in
  t.eq ["bar.wand", "foo.wand"] names)

test "*.ml matches" (fn t ->
  let dir = Path.of_string scratch in
  let () = FS.write_file! (Path.of_string "%{scratch}/foo.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/baz.ml") "" in
  let names =
    FS.glob_in *.ml dir |> List.map (fn p -> Path.to_string (Path.basename p)) |> List.sort
  in
  let () = FS.delete! (Path.of_string "%{scratch}/foo.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/baz.ml") in t.eq ["baz.ml"] names)

test "no match" (fn t ->
  let dir = Path.of_string scratch in
  let () = FS.write_file! (Path.of_string "%{scratch}/foo.wand") "" in
  let names =
    FS.glob_in *.py dir |> List.map (fn p -> Path.to_string (Path.basename p)) |> List.sort
  in
  let () = FS.delete! (Path.of_string "%{scratch}/foo.wand") in t.eq [] names)

test "./* matches all" (fn t ->
  let dir = Path.of_string scratch in
  let () = FS.write_file! (Path.of_string "%{scratch}/foo.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/bar.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/baz.ml") "" in
  let names =
    FS.glob_in ./* dir |> List.map (fn p -> Path.to_string (Path.basename p)) |> List.sort
  in
  let () = FS.delete! (Path.of_string "%{scratch}/foo.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/bar.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/baz.ml") in
  t.eq ["bar.wand", "baz.ml", "foo.wand"] names)

test "** recursive" (fn t ->
  let dir = Path.of_string scratch in
  let () = FS.mkdir! (Path.of_string "%{scratch}/sub") in
  let () = FS.write_file! (Path.of_string "%{scratch}/a.wand") "" in
  let () = FS.write_file! (Path.of_string "%{scratch}/sub/b.wand") "" in
  let names =
    FS.glob_in **.wand dir
      |> List.map (fn p -> Path.to_string (Path.basename p))
      |> List.sort
  in
  let () = FS.delete! (Path.of_string "%{scratch}/a.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/sub/b.wand") in
  let () = FS.delete! (Path.of_string "%{scratch}/sub") in t.eq ["a.wand", "b.wand"] names)

test "cleanup scratch directory" (fn t ->
  let () = FS.delete! (Path.of_string scratch) in t.ok true)
