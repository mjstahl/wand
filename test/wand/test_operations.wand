  test "IO!print via IO.print" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = IO.print "x" in missed) () with
      | IO!print _ _ -> caught
      )),
  test "IO!println" (fn t ->
    t.eq
      caught
