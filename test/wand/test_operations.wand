      )),
  test "IO!flush" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = IO.flush () in missed) () with
      | IO!flush _ _ -> caught
      )),
  test "IO!stdin_lines" (fn t ->
    t.eq
      caught
      (handle (fn () -> (Stream.fold_left (fn a _ -> a) 0 (IO.stdin_lines ()); missed)) () with
      | IO!stdin_lines _ _ -> caught
      ))
])

group "the environment" (fn () -> [
  test "Env!get" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.get! "WAND_TEST_OPS" in missed) () with
      | Env!get _ _ -> caught
      )),
  test "Env!get via Env.get" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.get "WAND_TEST_OPS" in missed) () with
      | Env!get _ _ -> caught
      )),
  test "Env!set" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.set "WAND_TEST_OPS" "1" in missed) () with
      | Env!set _ _ -> caught
      )),
  test "Env!set via Env.load!" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.load! absent in missed) () with
      | FS!read_file _ k -> k "WAND_TEST_OPS=1\n"
      | Env!set _ _ -> caught
      )),
  test "Env!clear" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.clear "WAND_TEST_OPS" in missed) () with
      | Env!clear _ _ -> caught
      )),
  test "Env!all" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.all () in missed) () with
      | Env!all _ _ -> caught
      )),
  test "Env!home" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.home () in missed) () with
      | Env!home _ _ -> caught
      )),
  test "Env!user" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.user () in missed) () with
      | Env!user _ _ -> caught
      )),
  test "Env!read via Env.read!" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Env.read! absent in missed) () with
      | FS!read_file _ k -> k "WAND_TEST_OPS=1\n"
      | Env!read _ _ -> caught
      ))
])

group "subprocesses and exit" (fn () -> [
  test "Shell!command is performed by $*(...)" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = $*(echo hi) in missed) () with
      | Shell!command _ _ -> caught
      )),
  test "Shell!stream is performed by Shell.stream" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Stream.to_list (Shell.stream $*(echo hi)) in missed) () with
      | Shell!stream _ _ -> caught
      )),
  test "Shell!run is performed by Shell.run!" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Shell.run! $*(echo hi) in missed) () with
      | Shell!run _ _ -> caught
      )),
  test "Shell!capture is performed by Shell.query" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Shell.query $*(echo hi) in missed) () with
      | Shell!capture _ _ -> caught
      )),
  test "Shell!run is performed by $(...)" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = $(echo hi) in missed) () with
      | Shell!run _ _ -> caught
      )),
  test "Shell!capture is performed by $?(...)" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = $?(echo hi) in missed) () with
      | Shell!capture _ _ -> caught
      )),
  test "Proc!exit" (fn t ->
    t.eq
      caught
      (handle (fn () -> let _ = Proc.exit 0 in missed) () with
      | Proc!exit _ _ -> caught
      ))
])
