import Test
import JSON
import List
import Map
import Path
import FS

(* ── parse ─────────────────────────────────────────────────────────────── *)

test "null" (fn t -> t.eq (match JSON.parse "null" with
| Ok j -> JSON.stringify j
| Error _ -> "err") "null")

test "number" (fn t -> t.eq (match JSON.parse "42" with
| Ok j -> JSON.stringify j
| Error _ -> "err") "42")

test "string" (fn t -> t.eq (match JSON.parse "\"hello\"" with
| Ok j -> JSON.stringify j
| Error _ -> "err") "\"hello\"")

test "bad JSON returns Error" (fn t -> t.eq (match JSON.parse "{bad}" with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "parse! valid" (fn t -> t.eq (JSON.stringify (JSON.parse! "true")) "true")
test "parse! invalid raises" (fn t -> t.raises (fn () -> JSON.parse! "not json"))

(* ── get_* extractors ─────────────────────────────────────────────────── *)

test "get_bool true" (fn t -> t.eq (match JSON.get_bool (JSON.parse! "true") with
| Ok b -> b
| Error _ -> false) true)

test "get_bool wrong type" (fn t -> t.eq (match JSON.get_bool (JSON.parse! "42") with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "get_int" (fn t -> t.eq (match JSON.get_int (JSON.parse! "99") with
| Ok n -> n
| Error _ -> -1) 99)

test "get_int wrong type" (fn t -> t.eq (match JSON.get_int (JSON.parse! "\"hi\"") with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "get_float from float literal" (fn t -> t.eq (match JSON.get_float (JSON.parse! "3.14") with
| Ok f -> f > 3.0
| Error _ -> false) true)

test "get_float from int literal" (fn t -> t.eq (match JSON.get_float (JSON.parse! "2") with
| Ok f -> f == 2.0
| Error _ -> false) true)

test "get_string" (fn t -> t.eq (match JSON.get_string (JSON.parse! "\"world\"") with
| Ok s -> s
| Error _ -> "") "world")

test "get_array length" (fn t -> t.eq (match JSON.get_array (JSON.parse! "[1,2,3]") with
| Ok xs -> List.length xs
| Error _ -> -1) 3)

test "get_object then field" (fn t -> t.eq (match JSON.get_object (JSON.parse! "{\"k\":\"v\"}") with
| Ok m -> JSON.stringify (Map.get! "k" m)
| Error _ -> "") "\"v\"")

(* ── field / field! ────────────────────────────────────────────────────── *)

test "field exists" (fn t -> let j = JSON.parse! "{\"name\":\"Alice\",\"age\":30}" in
t.eq (match JSON.field "name" j with
| Ok v -> JSON.stringify v
| Error _ -> "") "\"Alice\"")

test "field missing" (fn t -> let j = JSON.parse! "{\"a\":1}" in
t.eq (match JSON.field "z" j with
| Ok _ -> "ok"
| Error _ -> "error") "error")

test "field! exists" (fn t -> let j = JSON.parse! "{\"x\":42}" in t.eq (JSON.stringify (JSON.field! "x" j)) "42")

test "field! missing raises" (fn t -> let j = JSON.parse! "{\"a\":1}" in t.raises (fn () -> JSON.field! "z" j))

(* ── construction ──────────────────────────────────────────────────────── *)

test "of_bool" (fn t -> t.eq (JSON.stringify (JSON.of_bool true)) "true")
test "of_int" (fn t -> t.eq (JSON.stringify (JSON.of_int 7)) "7")
test "of_float" (fn t -> t.eq (JSON.stringify (JSON.of_float 1.5)) "1.5")
test "of_string" (fn t -> t.eq (JSON.stringify (JSON.of_string "hi")) "\"hi\"")
test "of_list" (fn t -> t.eq (JSON.stringify (JSON.of_list [JSON.of_int 1, JSON.of_int 2])) "[1,2]")
test "null and is_null" (fn t -> t.eq (JSON.is_null? JSON.null) true)

(* ── stringify_pretty ──────────────────────────────────────────────────── *)

test "pretty round-trips" (fn t -> let j = JSON.parse! "{\"a\":1}" in
let s = JSON.stringify_pretty j in
t.eq (match JSON.parse s with
| Ok _ -> "ok"
| Error _ -> "error") "ok")

(* ── read_file ─────────────────────────────────────────────────────────── *)

test "read_file ok" (fn t -> let p = FS.temp_file! "wand_json_rd_" ".json" in
let () = FS.write_file! (Path.to_string p) "{\"greeting\":\"hello\"}" in
let outcome = match JSON.read_file p with
| Ok j -> JSON.stringify (JSON.field! "greeting" j)
| Error _ -> "" in
let () = FS.delete! p in t.eq outcome "\"hello\"")

test "read_file missing file returns Error" (fn t -> t.eq (match JSON.read_file (Path.of_string "/nonexistent/wand_missing.json") with
| Ok _ -> "ok"
| Error _ -> "error") "error")
