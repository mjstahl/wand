import Test

(* Private-symbol-access denial and missing-destructure-field errors both
   fail the whole file to typecheck before any test body runs, and both
   need a relative import resolved against this file's own directory --
   `Types.check_program` only sees a source string, with no reliable
   relationship to a particular file's directory, so those two cases stay
   in test_imports.ml. Everything else moves here. *)

let mylib = import ./imports_fixture

test "whole module bound to name" (fn t -> t.eq mylib.answer 42)
test "function call via bound name" (fn t -> t.eq (mylib.double 21) 42)
test "multiple fields accessible" (fn t -> t.eq (mylib.x + mylib.y) 3)

let Mylib = import ./imports_fixture

test "capital name works" (fn t -> t.eq Mylib.greet "hello")

let L = import List
let Strs = import String

test "stdlib bound to custom name" (fn t -> t.eq (L.length [1, 2, 3]) 3)
test "stdlib with different local name" (fn t -> t.eq (Strs.upper "hello") "HELLO")

let [foo = a, bar = b] = import ./imports_fixture

test "destructure two fields" (fn t -> t.eq (a + b) 30)

let [double = dbl] = import ./imports_fixture

test "destructure function" (fn t -> t.eq (dbl 21) 42)

let [answer, pi] = import ./imports_fixture

test "shorthand list destructure" (fn t -> t.eq (answer + pi) 45)
