import List
import String
import Version
let{test}=import Test
test""(fn t->t.eq(1,2,3)(Version.major 1.2.1,Version.minor 1.2.3-c,Version.patch 1.2.3))
test""(fn t->t.eq(Some"")(Version.prerelease 1.2.1))
test""(fn t->match Version.of_string""with|Ok v->t.eq(Some"")(Version.build v)|Error _->t.ok false)
test""(fn t->match Version.of_string""with|Ok v->t.eq(Some"",Some"")(Version.prerelease v,Version.build v)|Error _->t.ok false)
test""(fn t->t.eq[1.0.0-a .a,1.0.0](List.sort [
    ]))
test "why" (fn t ->
  match Version.of_string "banana" with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.contains? "s" e))
test "ander" (fn t ->
  match Version.of_parts 1 (0 - 1) 3 with
  | Ok _ -> t.ok false
  | Error e -> t.ok (String.contains? "canive" e))