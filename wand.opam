# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A typed ML-style scripting language for Human-AI collaboration"
description:
  "wand is a typed, ML-style scripting language designed for Human-AI collaboration, with Hindley-Milner type inference, pattern matching, and Result-based error handling."
maintainer: ["Mark Stahl <mark@technicallycorrect.company>"]
authors: ["Mark Stahl <mark@technicallycorrect.company>"]
license: "MIT"
tags: ["scripting-language" "type-inference" "ml" "interpreter"]
homepage: "https://github.com/mjstahl/wand"
bug-reports: "https://github.com/mjstahl/wand/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml"
  "linenoise"
  "yojson"
  "toml"
  "re"
  "digestif"
  "eqaf"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mjstahl/wand.git"
x-maintenance-intent: ["(latest)"]
