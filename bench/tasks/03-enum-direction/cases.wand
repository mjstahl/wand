import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

check "N->S" (Solution.opposite North == South)
check "S->N" (Solution.opposite South == North)
check "E->W" (Solution.opposite East  == West)
check "W->E" (Solution.opposite West  == East)
println "ALL PASS"
