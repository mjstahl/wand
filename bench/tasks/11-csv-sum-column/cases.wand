import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

let csv1 = "name,age\nAlice,30\nBob,25\nCarol,40"
let csv2 = "a,b,c\n1,2,3\n4,5,6"

check "age column"  (Solution.sum_column 1 csv1 == 95)
check "col 0"        (Solution.sum_column 0 csv2 == 5)
check "col 2"        (Solution.sum_column 2 csv2 == 9)
println "ALL PASS"
