import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

check "same point"  (Solution.manhattan (Point (x = 1, y = 1)) (Point (x = 1, y = 1)) == 0)
check "simple"       (Solution.manhattan (Point (x = 0, y = 0)) (Point (x = 3, y = 4)) == 7)
check "negative"     (Solution.manhattan (Point (x = -2, y = 3)) (Point (x = 1, y = -1)) == 7)
println "ALL PASS"
