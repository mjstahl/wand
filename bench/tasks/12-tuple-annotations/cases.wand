import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

check "origin"    (Solution.origin == (0, 0))
check "translate"  (Solution.translate (1, 2) (3, 4) == (4, 6))
check "with origin" (Solution.translate Solution.origin (5, 5) == (5, 5))
println "ALL PASS"
