import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

let is_ok_with n r = match r with
| Ok v    -> v == n
| Error _ -> false

let is_err r = match r with
| Ok _    -> false
| Error _ -> true

let even n = n % 2 == 0
let gt10 n  = n > 10

check "first even"    (is_ok_with 4  (Solution.find_first even [1, 3, 4, 5, 6]))
check "first gt 10"   (is_ok_with 12 (Solution.find_first gt10 [1, 12, 3, 20]))
check "none match"    (is_err (Solution.find_first gt10 [1, 2, 3]))
check "empty list"    (is_err (Solution.find_first even []))
println "ALL PASS"
