import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

let is_err r = match r with
| Ok _    -> false
| Error _ -> true

let s1 = Solution.push 3 (Solution.push 2 (Solution.push 1 Solution.empty))

check "peek top"      (match Solution.peek s1 with | Ok v -> v == 3 | Error _ -> false)
check "peek empty"    (is_err (Solution.peek Solution.empty))
check "pop empty"     (is_err (Solution.pop Solution.empty))
check "pop then peek" (
  match Solution.pop s1 with
  | Ok (v, rest) -> v == 3 && (match Solution.peek rest with | Ok v2 -> v2 == 2 | Error _ -> false)
  | Error _      -> false
)
check "works for strings" (
  let ss = Solution.push "b" (Solution.push "a" Solution.empty) in
  match Solution.peek ss with | Ok v -> v == "b" | Error _ -> false
)
println "ALL PASS"
