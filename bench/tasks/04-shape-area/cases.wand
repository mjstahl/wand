import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

check "circle r=5"  (Solution.area (Circle 5) == 75)
check "rect 3x4"    (Solution.area (Rect 3 4) == 12)
check "rect 1x1"    (Solution.area (Rect 1 1) == 1)
println "ALL PASS"
