import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

check "empty"        (Solution.sum_evens [] == 0)
check "all odd"       (Solution.sum_evens [1, 3, 5] == 0)
check "mixed"         (Solution.sum_evens [1, 2, 3, 4, 5, 6] == 12)
check "all even"      (Solution.sum_evens [2, 4, 6] == 12)
check "negatives"     (Solution.sum_evens [-2, -3, 4] == 2)
println "ALL PASS"
