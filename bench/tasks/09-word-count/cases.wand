import Map
import ./solution

let check label ok =
  if ok then println "ok: ${label}"
  else let _ = println "FAIL: ${label}" in exit 1

let count_of w m = match Map.get w m with
| Ok n    -> n
| Error _ -> 0

let m = Solution.word_count ["a", "b", "a", "c", "b", "a"]

check "a count"     (count_of "a" m == 3)
check "b count"     (count_of "b" m == 2)
check "c count"     (count_of "c" m == 1)
check "missing"     (count_of "z" m == 0)
check "distinct"    (Map.size m == 3)
println "ALL PASS"
